# Copy to .env (or set these in the hosting platform's environment settings).
# .env is gitignored — never commit real credentials. Nothing here may carry a
# VITE_ prefix: anything VITE_-prefixed is inlined into the public bundle.

# --- Site ------------------------------------------------------------------
# Public origin of the deployed site. Used for canonical URLs (build time, via
# VITE_SITE_URL), for Stripe return URLs and for Higgsfield seed images.
SITE_URL=https://goodwork.agency
# VITE_SITE_URL=https://goodwork.agency

# --- Enquiries and applications (api/enquiry.js) ---------------------------
# Every form on the site posts here. At least ONE route must be set, or the
# endpoint returns 503 and the form offers an email fallback instead of
# pretending. That is on purpose.
#
# Route 1 — POST the enquiry as JSON to a CRM or automation tool.
ENQUIRY_WEBHOOK_URL=
# Optional. Sent as `Authorization: Bearer <token>` and `X-Webhook-Token`.
ENQUIRY_WEBHOOK_TOKEN=
# Route 2 — email via Resend. ENQUIRY_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO=hello@goodwork.agency
ENQUIRY_FROM=enquiries@goodwork.agency

# --- Direct purchase (api/checkout.js, api/stripe-webhook.js) --------------
# Without these, "Get Library Access" and "Get Goodwork Studio" show an honest
# "checkout isn't switched on yet" state and take an email. Nothing is simulated.
STRIPE_SECRET_KEY=
STRIPE_PRICE_LIBRARY=
STRIPE_PRICE_STUDIO=
# From the Stripe dashboard's webhook endpoint for /api/stripe-webhook.
STRIPE_WEBHOOK_SECRET=
# Where verified "entitlement.granted" events are delivered until an
# entitlement store exists. Falls back to ENQUIRY_WEBHOOK_URL / the email route.
ENTITLEMENT_WEBHOOK_URL=
ENTITLEMENT_WEBHOOK_TOKEN=

# --- Customer access and downloads (api/access.js, api/download.js) ---------
# The interim entitlement store until a database exists (docs/BACKEND.md).
# One entry per purchase, separated by commas or newlines:
#
#   <product>:<key>[:<label>]     product = library | studio
#
# A Studio key covers the Library too. The label is optional (the buyer's
# email is useful) and is shown back to that key holder only. Generate a key:
#
#   node -e "console.log('gw_'+require('crypto').randomBytes(18).toString('base64url'))"
#
# Keys are compared in constant time and never sent to the browser; the
# session cookie is HttpOnly and scoped to /api. Until this is set, /login
# says customer access isn't switched on yet and /api/download answers 503.
# On Vercel, a change here needs a redeploy to reach the functions.
ACCESS_KEYS=

# --- Proposal acceptance (api/accept.js) -----------------------------------
# Falls back to the ENQUIRY_* settings above when unset.
ACCEPT_WEBHOOK_URL=
ACCEPT_WEBHOOK_TOKEN=
ACCEPT_TO=
ACCEPT_FROM=

# --- The Content Console (api/console.js, api/console-image.js) -----------
# Powers the client consoles under /goodwork/brands/. Server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
HIGGSFIELD_API_KEY=

# --- Higgsfield live B-roll (api/broll.js) ---------------------------------
# The panel on /systems/content-console is only rendered when the public flag
# below is set at build time, and only works once HF_CREDENTIALS is set on the
# server. Set a hard spend cap on the Higgsfield account before enabling.
# VITE_BROLL_ENABLED=1
HF_CREDENTIALS=
