# Copy to .env (or set these in the hosting platform's environment settings).
# .env is gitignored — never commit real credentials. Nothing here may carry a
# VITE_ prefix: anything VITE_-prefixed is inlined into the public bundle.

# --- Site ------------------------------------------------------------------
# Public origin of the deployed site. Used for canonical URLs (build time, via
# VITE_SITE_URL), for Stripe return URLs and for Higgsfield seed images.
SITE_URL=https://goodworkagency.uk
# VITE_SITE_URL=https://goodworkagency.uk

# --- Enquiries and applications (api/enquiry.js) ---------------------------
# Every form on the site posts here. At least ONE route must be set, or the
# endpoint returns 503 and the form offers an email fallback instead of
# pretending. That is on purpose.
#
# Route 1 — POST the enquiry as JSON to a CRM or automation tool.
ENQUIRY_WEBHOOK_URL=
# Optional. Sent as `Authorization: Bearer <token>` and `X-Webhook-Token`.
ENQUIRY_WEBHOOK_TOKEN=
# Route 2 — email via Resend. ENQUIRY_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
ENQUIRY_TO=hello@goodwork.agency
ENQUIRY_FROM=enquiries@goodwork.agency

# --- Direct purchase (api/checkout.js, api/claim.js, api/stripe-webhook.js) -
# Without STRIPE_SECRET_KEY, "Get Library Access" and "Get Goodwork Studio"
# show an honest "checkout isn't switched on yet" state and take an email.
# Nothing is simulated. Try an sk_test_ key on Preview before the live one.
# Stripe needs a terms of service URL in its public business details before
# it will show the licence tick-box at checkout: <site>/legal/terms.
STRIPE_SECRET_KEY=
# Optional. Checkout finds or creates the £280 and £888 prices in Stripe by
# lookup key (goodwork_library_gbp_28000, …) the first time, so these are only
# needed to pin a price made by hand.
STRIPE_PRICE_LIBRARY=
STRIPE_PRICE_STUDIO=
# From the Stripe webhook endpoint for <site>/api/stripe-webhook, listening to
# checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_WEBHOOK_SECRET=
# Where each verified sale is delivered as an "entitlement.granted" event
# carrying the buyer's key. Falls back to ENQUIRY_WEBHOOK_URL / the email route.
ENTITLEMENT_WEBHOOK_URL=
ENTITLEMENT_WEBHOOK_TOKEN=

# --- Customer access and downloads (api/claim.js, api/access.js, api/download.js)
# Purchase keys are issued automatically once Stripe confirms a payment: the
# buyer lands on /welcome, sees their key and is signed in. Keys are signed
# with this secret rather than stored, so no database is needed. 32+ random
# characters:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Set it once and leave it alone: changing it withdraws every key already sold.
ACCESS_SIGNING_SECRET=
# Keys no longer honoured (a refund, a leaked key), by id, comma-separated.
# A purchase key's id is its third part (gw-lib-<id>-…), sent as accessKeyId
# with each sale; a hand-issued key's id is the keyId in the sign-in log.
ACCESS_REVOKED=
# Sender for the buyer's own copy of their key, on a domain verified in Resend
# (needs RESEND_API_KEY). Falls back to ENQUIRY_FROM.
ACCESS_EMAIL_FROM=
#
# Hand-issued keys, for sales outside checkout (an invoice), comps and your
# own access. One entry per key, separated by commas or newlines:
#
#   <product>:<key>[:<label>]     product = library | studio
#
# A Studio key covers the Library too. The label is optional (the buyer's
# email is useful) and is shown back to that key holder only. Generate a key:
#
#   node -e "console.log('gw_'+require('crypto').randomBytes(18).toString('base64url'))"
#
# Keys are compared in constant time and never sent to the browser as page
# data; the session cookie is HttpOnly and scoped to /api. With neither this
# nor ACCESS_SIGNING_SECRET set, /login says customer access isn't switched on
# yet and /api/download answers 503. On Vercel, a change to any variable here
# needs a redeploy to reach the functions.
ACCESS_KEYS=

# --- Proposal acceptance (api/accept.js) -----------------------------------
# Falls back to the ENQUIRY_* settings above when unset.
ACCEPT_WEBHOOK_URL=
ACCEPT_WEBHOOK_TOKEN=
ACCEPT_TO=
ACCEPT_FROM=

# --- The Content Console (api/console.js, api/console-image.js) -----------
# Powers the client consoles under /goodwork/brands/. Server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
HIGGSFIELD_API_KEY=

# --- Higgsfield live B-roll (api/broll.js) ---------------------------------
# The panel on /systems/content-console is only rendered when the public flag
# below is set at build time, and only works once HF_CREDENTIALS is set on the
# server. Set a hard spend cap on the Higgsfield account before enabling.
# VITE_BROLL_ENABLED=1
HF_CREDENTIALS=
