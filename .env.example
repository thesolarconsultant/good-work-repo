# Copy to .env (or set these in the hosting platform's environment settings).
# .env is gitignored — never commit real credentials.

# --- Higgsfield -----------------------------------------------------------
# Powers the live B-roll panel on /content-console via api/broll.js.
# Server-side only: this key is never sent to the browser, and must not be
# given a VITE_ prefix — anything VITE_-prefixed is inlined into the public
# bundle by Vite.
#
# Format is "KEY_ID:KEY_SECRET", from the Higgsfield dashboard.
HF_CREDENTIALS=

# Or supply the halves separately instead of HF_CREDENTIALS:
# HF_API_KEY=
# HF_API_SECRET=

# Public origin of the deployed site. Higgsfield fetches the seed image over
# the network, so it needs an absolute, publicly reachable URL — the panel
# cannot work against localhost. Falls back to the request's own origin.
SITE_URL=https://goodwork.agency

# --- The Content Console -------------------------------------------------
# Powers every "write this" button in Beauty Heaven's console, via
# api/console.js. Server-side only: an Anthropic key in the bundle is a free
# model for whoever opens devtools, so this must never carry a VITE_ prefix.
#
# Without it the endpoint returns 503 and the console says, on screen, that
# this deployment has no key set. That is deliberate — a console that silently
# returns nothing looks broken, and one that fakes an answer is worse.
ANTHROPIC_API_KEY=

# Optional. low | medium | high | xhigh | max. Defaults to medium: this is
# short-form copy in a fixed voice rather than a reasoning problem, and medium
# keeps a serverless invocation comfortably inside its time limit. Raise it if
# the writing needs more thought; expect it to cost more and take longer.
CONSOLE_EFFORT=medium

# --- Scope builder enquiries ---------------------------------------------
# Powers the "Send this to Good Work" step on /services via api/enquiry.js.
# At least ONE of the two routes below must be set, or the endpoint returns
# 503 and the site falls back to an email link. That is on purpose: an
# unconfigured endpoint must never tell a client their enquiry was sent.

# Route 1 — POST the enquiry as JSON to anything that accepts a webhook:
# GoHighLevel, Zapier, Make, n8n, or your own endpoint. The body is flat at
# the top level — name, firstName, lastName, email, phone, companyName, tags,
# services — so a CRM can map it straight onto a contact record with no
# transform step in between.
ENQUIRY_WEBHOOK_URL=

# Optional. Sent as both `Authorization: Bearer <token>` and `X-Webhook-Token`,
# for endpoints that want one. Leave blank if yours doesn't.
ENQUIRY_WEBHOOK_TOKEN=

# Route 2 — send it as an email via Resend (resend.com).
# ENQUIRY_FROM must be on a domain verified in Resend, or it is rejected.
# ENQUIRY_TO accepts a comma-separated list.
RESEND_API_KEY=
ENQUIRY_TO=hello@goodwork.agency
ENQUIRY_FROM=enquiries@goodwork.agency
