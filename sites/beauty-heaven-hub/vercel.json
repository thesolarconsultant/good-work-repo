{
  "cleanUrls": true,
  "trailingSlash": true,
  "outputDirectory": "public",
  "buildCommand": "node build.mjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(fonts|photos|logo)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "installCommand": "npm install --no-audit --no-fund",
  "functions": {
    "api/telegram.js": {
      "maxDuration": 60
    },
    "api/whatsapp.js": {
      "maxDuration": 60
    },
    "api/console-week.js": {
      "maxDuration": 120
    }
  }
}
