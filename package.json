{
  "name": "good-work-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run images && npm run sitemap",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:file": "VITE_HASH_ROUTER=1 vite build --base ./ && node scripts/build-preview.mjs",
    "images": "node scripts/optimise-images.mjs",
    "logo": "node scripts/build-logo.mjs",
    "og": "node scripts/build-og.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "portrait": "node scripts/build-portrait.mjs",
    "merch": "node scripts/build-merch.mjs",
    "brand:logo": "node scripts/build-brand-logo.mjs",
    "brand:photos": "node scripts/build-brand-photos.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "opentype.js": "^1.3.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "vite": "^8.2.0"
