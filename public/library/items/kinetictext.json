{"id":"kinetictext","code":"<style>.kin{font:900 34px Inter,sans-serif;color:var(--accent,#3366FF);display:inline-flex}\n.kin span{display:inline-block;animation:kin 1.2s ease-in-out infinite}\n@keyframes kin{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}</style>\n<div class=\"kin\" id=\"kin\"></div>\n<script>var t=\"GOOD WORK.\",el=document.getElementById('kin');el.innerHTML=t.split('').map(function(c,i){return '<span style=\"animation-delay:'+(i*0.1)+'s\">'+c+'</span>';}).join('');</script>"}