{"id":"testimonialcarousel","code":"<style>.tcar{width:330px;overflow:hidden;font-family:Inter,system-ui,sans-serif;padding:14px 0;-webkit-mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}\n.tcar .rail{display:flex;gap:12px;width:max-content;animation:tcarm 18s linear infinite}\n.tcar:hover .rail{animation-play-state:paused}\n.tcar .slide{position:relative;width:200px;height:150px;border-radius:14px;overflow:hidden;flex:none;border:1px solid var(--line,#262C34)}\n.tcar .slide .bg{position:absolute;inset:0;background-size:cover;background-position:center}\n.tcar .slide.s1 .bg{background-image:linear-gradient(135deg,#7A5CFF,#C0392B)}\n.tcar .slide.s2 .bg{background-image:linear-gradient(135deg,#5B5BFF,#1E9E6A)}\n.tcar .slide.s3 .bg{background-image:linear-gradient(135deg,#F5A623,#3366FF)}\n.tcar .cap{position:absolute;left:10px;right:10px;bottom:10px;background:rgba(20,22,28,.45);backdrop-filter:blur(6px);border:1px solid rgba(255,255,255,.14);border-radius:10px;padding:9px}\n.tcar .cap p{margin:0;color:#fff;font:600 10px Inter,sans-serif;line-height:1.35}\n.tcar .cap b{display:block;margin-top:5px;color:#fff;font:700 9px Inter,sans-serif}\n.tcar .cap b span{display:block;font-weight:500;opacity:.8;font-size:8px}\n@keyframes tcarm{to{transform:translateX(calc(-212px * 3))}}\n@media (prefers-reduced-motion:reduce){.tcar .rail{animation:none}}</style>\n<div class=\"tcar\"><div class=\"rail\" id=\"tcr\">\n<div class=\"slide s1\"><div class=\"bg\"></div><div class=\"cap\"><p>A compelling piece of contemporary design.</p><b>John Doe<span>CEO, Company</span></b></div></div>\n<div class=\"slide s2\"><div class=\"bg\"></div><div class=\"cap\"><p>Boosted our output overnight — genuinely.</p><b>Jane Smith<span>Head of Design</span></b></div></div>\n<div class=\"slide s3\"><div class=\"bg\"></div><div class=\"cap\"><p>The best library we have shipped with.</p><b>Alex Lee<span>Founder</span></b></div></div>\n</div></div>\n<script>(function(){var r=document.getElementById('tcr');r.innerHTML+=r.innerHTML;})();</script>"}