{"id":"marqueereverse","code":"<style>.mqr{overflow:hidden;width:280px;-webkit-mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}\n.mqr ul{display:flex;gap:30px;list-style:none;padding:0;margin:0;width:max-content;animation:mqrm 13s linear infinite reverse}\n.mqr li{font:800 17px Inter,sans-serif;color:var(--accent,#3366FF);white-space:nowrap}\n@keyframes mqrm{to{transform:translateX(-50%)}}</style>\n<div class=\"mqr\"><ul id=\"mqrl\"></ul></div>\n<script>var n=['Solar','Battery','Heating','EV','Insights','Grid'],u=document.getElementById('mqrl');u.innerHTML=n.concat(n).map(function(x){return '<li>'+x+'</li>';}).join('');</script>"}