{"id":"underline","code":"<style>.ul{font:700 20px Inter,sans-serif;color:var(--ink,#fff);text-decoration:none;position:relative}\n.ul::after{content:\"\";position:absolute;left:0;bottom:-4px;height:2px;width:100%;background:var(--accent,#3366FF);\n transform:scaleX(0);transform-origin:left;transition:transform .35s cubic-bezier(.22,1,.36,1)}\n.ul:hover::after{transform:scaleX(1)}</style>\n<a class=\"ul\" href=\"#\">See the system</a>"}