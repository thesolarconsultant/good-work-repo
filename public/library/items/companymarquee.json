{"id":"companymarquee","code":"<style>.cmq{width:340px;font-family:Inter,system-ui,sans-serif;padding:16px 0;text-align:center}\n.cmq h3{margin:0 0 14px;color:var(--body,#B6BDC8);font:700 10px Inter,sans-serif;letter-spacing:.14em}\n.cmq .rail{overflow:hidden;-webkit-mask:linear-gradient(90deg,transparent,#000 18%,#000 82%,transparent);mask:linear-gradient(90deg,transparent,#000 18%,#000 82%,transparent)}\n.cmq .track{display:flex;gap:34px;width:max-content;animation:cmqm 16s linear infinite}\n.cmq:hover .track{animation-play-state:paused}\n.cmq .track span{color:#8A93A2;font:800 15px Inter,sans-serif;letter-spacing:-.02em;white-space:nowrap}\n@keyframes cmqm{to{transform:translateX(-50%)}}\n@media(prefers-reduced-motion:reduce){.cmq .track{animation:none}}</style>\n<div class=\"cmq\"><h3>TRUSTED BY LEADING TEAMS</h3><div class=\"rail\"><div class=\"track\" id=\"cmqt\"><span>Google</span><span>Microsoft</span><span>Amazon</span><span>Netflix</span><span>Uber</span><span>Spotify</span><span>Instagram</span><span>YouTube</span></div></div></div>\n<script>(function(){var t=document.getElementById('cmqt');t.innerHTML+=t.innerHTML;})();</script>"}