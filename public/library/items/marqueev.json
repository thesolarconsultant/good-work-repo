{"id":"marqueev","code":"<style>.mqv{height:130px;overflow:hidden;-webkit-mask:linear-gradient(transparent,#000 15%,#000 85%,transparent);mask:linear-gradient(transparent,#000 15%,#000 85%,transparent)}\n.mqv ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;animation:mqvm 8s linear infinite}\n.mqv li{font:700 14px Inter,sans-serif;color:var(--ink,#fff);background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:10px;padding:8px 20px;text-align:center}\n@keyframes mqvm{to{transform:translateY(-50%)}}</style>\n<div class=\"mqv\"><ul id=\"mqv\"></ul></div>\n<script>var it=['Solar','Battery','Heating','EV','Insights'],u=document.getElementById('mqv');u.innerHTML=it.concat(it).map(function(n){return '<li>'+n+'</li>';}).join('');</script>"}