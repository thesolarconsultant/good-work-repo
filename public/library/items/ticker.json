{"id":"ticker","code":"<style>.tk{display:inline-flex;gap:2px;color:var(--accent,#3366FF);font:900 54px Inter,system-ui,sans-serif;font-variant-numeric:tabular-nums}\n.tk .col{width:.66em;height:56px;overflow:hidden}\n.tk .strip{display:flex;flex-direction:column;transition:transform 1.2s cubic-bezier(.22,1,.36,1)}\n.tk .strip span{height:56px;line-height:56px;text-align:center}</style>\n<div class=\"tk\" id=\"tk\"></div>\n<script>var val=\"1284\",tk=document.getElementById('tk');\nvar digits='<span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span>';\ntk.innerHTML=val.split('').map(function(){return '<span class=\"col\"><span class=\"strip\">'+digits+'</span></span>';}).join('');\nfunction roll(){var s=tk.querySelectorAll('.strip');val.split('').forEach(function(d,i){setTimeout(function(){s[i].style.transform='translateY(-'+(parseInt(d,10)*56)+'px)';},80+i*130);});}\nfunction reset(){tk.querySelectorAll('.strip').forEach(function(s){s.style.transition='none';s.style.transform='translateY(0)';});requestAnimationFrame(function(){tk.querySelectorAll('.strip').forEach(function(s){s.style.transition='';});roll();});}\nroll();setInterval(reset,3400);</script>"}