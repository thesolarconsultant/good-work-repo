{"id":"text3dflip","code":"<style>.t3d{perspective:600px;font:900 30px Inter,sans-serif}\n.t3d .in{position:relative;trans-style:preserve-3d;transform-style:preserve-3d;width:150px;height:44px;animation:t3 3s ease-in-out infinite}\n.t3d .f{position:absolute;inset:0;display:grid;place-items:center;backface-visibility:hidden}\n.t3d .a{color:var(--accent,#3366FF)}.t3d .b{color:var(--ink,#fff);transform:rotateX(180deg)}\n@keyframes t3{0%,40%{transform:rotateX(0)}60%,100%{transform:rotateX(180deg)}}</style>\n<div class=\"t3d\"><div class=\"in\"><div class=\"f a\">SOLAR</div><div class=\"f b\">SAVINGS</div></div></div>"}