{"id":"heroavatars","code":"<style>.hav{width:340px;font-family:Inter,system-ui,sans-serif;padding:18px 14px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:13px}\n.hav h1{margin:0;font:600 21px Inter,sans-serif;line-height:1.25;letter-spacing:-.02em;max-width:290px}\n.hav h1 b{color:var(--ink,#fff);font-weight:700}.hav h1 span{color:#6B7482}\n.hav .cta{display:flex;gap:10px}\n.hav .cta a{font:700 12px Inter,sans-serif;padding:9px 18px;border-radius:99px;text-decoration:none}\n.hav .cta .p{background:var(--accent,#3366FF);color:#fff}.hav .cta .s{background:var(--card,#171B22);border:1px solid var(--line,#262C34);color:var(--ink,#fff)}\n.hav .proof{display:flex;align-items:center;gap:10px}\n.hav .stack{display:flex}\n.hav .stack i{width:26px;height:26px;border-radius:50%;border:2px solid #0B0E13;margin-left:-8px;display:block}\n.hav .stack i:first-child{margin-left:0}\n.hav .stack i:nth-child(1){background:linear-gradient(135deg,#7A5CFF,#3366FF)}.hav .stack i:nth-child(2){background:linear-gradient(135deg,#5B5BFF,#1E9E6A)}.hav .stack i:nth-child(3){background:linear-gradient(135deg,#F5A623,#C0392B)}.hav .stack i:nth-child(4){background:linear-gradient(135deg,#7C4DFF,#FF2E88)}\n.hav .proof span{color:var(--body,#B6BDC8);font:500 11px Inter,sans-serif}</style>\n<div class=\"hav\"><h1><b>GOOD WORK. Design Studio:</b> <span>ship better web experiences.</span></h1><div class=\"cta\"><a class=\"p\">Start free trial</a><a class=\"s\">See a demo</a></div><div class=\"proof\"><div class=\"stack\"><i></i><i></i><i></i><i></i></div><span>Trusted by 12k+ designers</span></div></div>"}