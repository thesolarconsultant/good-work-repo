{"id":"safari","code":"<style>.saf{width:260px;border-radius:12px;overflow:hidden;border:1px solid var(--line,#262C34);background:#0b0e13}\n.saf .bar{display:flex;align-items:center;gap:7px;padding:9px 11px;background:#12161c}\n.saf .bar i{width:9px;height:9px;border-radius:50%;background:#2f313c}\n.saf .url{flex:1;margin-left:8px;height:18px;border-radius:6px;background:#0b0e13;border:1px solid #262C34;font:500 10px 'JetBrains Mono',monospace;color:#8A93A2;display:flex;align-items:center;padding:0 10px}\n.saf .screen{height:120px;background:linear-gradient(135deg,#1a2233,#0b0e13);display:grid;place-items:center;color:var(--accent,#3366FF);font:900 22px Inter,sans-serif}</style>\n<div class=\"saf\"><div class=\"bar\"><i></i><i></i><i></i><span class=\"url\">goodwork.nl</span></div><div class=\"screen\">GOOD WORK.</div></div>"}