{"id":"countup","code":"<style>.cu{font:900 54px Inter,sans-serif;color:var(--accent,#3366FF);font-variant-numeric:tabular-nums}</style>\n<div class=\"cu\" id=\"cu\">0%</div>\n<script>\nvar el=document.getElementById('cu');\nfunction up(){var t0=null,dur=1500;function f(ts){if(!t0)t0=ts;var p=Math.min(1,(ts-t0)/dur);\n el.textContent=Math.round((1-Math.pow(1-p,3))*80)+'%';if(p<1)requestAnimationFrame(f);}requestAnimationFrame(f);}\nup();setInterval(up,3000);\n</script>"}