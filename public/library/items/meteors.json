{"id":"meteors","code":"<style>.met{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;border:1px solid var(--line,#262C34);\n background:radial-gradient(circle at 50% -20%,#12161c,#0b0e13)}\n.met i{position:absolute;top:-10px;width:2px;height:56px;background:linear-gradient(var(--accent,#3366FF),transparent);animation:metf linear infinite}\n@keyframes metf{0%{transform:rotate(35deg) translateY(-50px);opacity:0}10%{opacity:1}100%{transform:rotate(35deg) translateY(230px);opacity:0}}</style>\n<div class=\"met\" id=\"met\"></div>\n<script>var m=document.getElementById('met');for(var i=0;i<9;i++){var s=document.createElement('i');s.style.left=(Math.random()*100)+'%';s.style.animationDuration=(1.2+Math.random()*1.6)+'s';s.style.animationDelay=(Math.random()*2.2)+'s';m.appendChild(s);}</script>"}