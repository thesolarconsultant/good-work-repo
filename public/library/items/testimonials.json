{"id":"testimonials","code":"<style>.tst{position:relative;width:252px;height:120px}\n.tst .q{position:absolute;inset:0;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:14px;padding:16px 18px;\n opacity:0;transform:translateX(18px);transition:.5s cubic-bezier(.22,1,.36,1);font:500 14px Inter,sans-serif;color:var(--ink,#fff);line-height:1.5}\n.tst .q.on{opacity:1;transform:none}\n.tst .q b{color:var(--accent,#3366FF);display:block;margin-top:9px;font-size:12px;font-weight:700}</style>\n<div class=\"tst\" id=\"tst\">\n<div class=\"q on\">&ldquo;Bills down 78% — honestly unreal.&rdquo;<b>— Sarah, Leeds</b></div>\n<div class=\"q\">&ldquo;Installed in a day and left it spotless.&rdquo;<b>— James, Bristol</b></div>\n<div class=\"q\">&ldquo;Only wish I&rsquo;d done it sooner.&rdquo;<b>— Priya, London</b></div></div>\n<script>var qs=document.querySelectorAll('#tst .q'),i=0;setInterval(function(){qs[i].classList.remove('on');i=(i+1)%qs.length;qs[i].classList.add('on');},2400);</script>"}