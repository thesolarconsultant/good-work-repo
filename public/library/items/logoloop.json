{"id":"logoloop","code":"<style>.llp{overflow:hidden;width:270px;-webkit-mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}\n.llp ul{display:flex;gap:18px;list-style:none;margin:0;padding:0;width:max-content;animation:llpm 14s linear infinite;align-items:center}\n.llp li{font:800 15px Inter,sans-serif;color:var(--ink,#fff);opacity:.75;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:10px;padding:10px 16px;white-space:nowrap}\n@keyframes llpm{to{transform:translateX(-50%)}}</style>\n<div class=\"llp\"><ul id=\"llpl\"></ul></div>\n<script>var g=['Enphase','JA Solar','LONGi','Huawei','GoodWe','Tesla'],u=document.getElementById('llpl');u.innerHTML=g.concat(g).map(function(x){return '<li>'+x+'</li>';}).join('');</script>"}