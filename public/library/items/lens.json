{"id":"lens","code":"<style>.lens{position:relative;width:210px;height:120px;border-radius:14px;overflow:hidden;cursor:crosshair;\n background:repeating-linear-gradient(45deg,#171B22 0 12px,#12161c 12px 24px);display:grid;place-items:center;color:var(--ink,#fff);font:700 15px Inter,sans-serif}\n.lens .z{position:absolute;width:84px;height:84px;border-radius:50%;border:2px solid var(--accent,#3366FF);pointer-events:none;opacity:0;transition:opacity .2s;\n background:radial-gradient(circle,rgba(51,102,255,.18),transparent 70%);box-shadow:0 0 24px rgba(51,102,255,.4)}\n.lens:hover .z{opacity:1}</style>\n<div class=\"lens\" id=\"lens\">Hover to zoom<span class=\"z\" id=\"lz\"></span></div>\n<script>var l=document.getElementById('lens'),z=document.getElementById('lz');l.addEventListener('pointermove',function(e){var r=l.getBoundingClientRect();z.style.left=(e.clientX-r.left-42)+'px';z.style.top=(e.clientY-r.top-42)+'px';});</script>"}