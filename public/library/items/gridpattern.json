{"id":"gridpattern","code":"<style>.gp2{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;border:1px solid var(--line,#262C34);\n background-color:#0b0e13;background-image:linear-gradient(var(--line,#262C34) 1px,transparent 1px),linear-gradient(90deg,var(--line,#262C34) 1px,transparent 1px);background-size:24px 24px}\n.gp2 i{position:absolute;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(51,102,255,.4),transparent 60%);animation:gpm 6s ease-in-out infinite}\n@keyframes gpm{0%{left:-50px;top:-30px}50%{left:170px;top:70px}100%{left:-50px;top:-30px}}</style>\n<div class=\"gp2\"><i></i></div>"}