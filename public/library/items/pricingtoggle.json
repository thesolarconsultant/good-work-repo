{"id":"pricingtoggle","code":"<style>.pto{font-family:Inter,system-ui,sans-serif;padding:14px 4px;display:flex;flex-direction:column;align-items:center;gap:14px}\n.pto .sw{display:inline-flex;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:999px;padding:3px}\n.pto .sw button{border:0;background:transparent;color:var(--body,#B6BDC8);font:700 10px Inter,sans-serif;padding:7px 14px;border-radius:999px;cursor:pointer}\n.pto .sw button.on{background:var(--accent,#3366FF);color:#fff}\n.pto .row{display:flex;gap:10px}\n.pto .card{width:130px;border:1px solid var(--line,#262C34);border-radius:14px;padding:14px;background:var(--card,#171B22);display:flex;flex-direction:column;gap:6px}\n.pto h4{margin:0;color:var(--body,#B6BDC8);font:700 10px Inter,sans-serif;text-transform:uppercase;letter-spacing:.05em}\n.pto .p{color:var(--ink,#fff);font:800 24px Inter,sans-serif;line-height:1}.pto .p span{font:600 10px Inter,sans-serif;color:var(--body,#B6BDC8)}\n.pto a{margin-top:4px;text-align:center;text-decoration:none;color:#fff;background:var(--accent,#3366FF);font:700 10px Inter,sans-serif;padding:8px;border-radius:9px}</style>\n<div class=\"pto\">\n<div class=\"sw\"><button class=\"on\" data-b=\"m\">Monthly</button><button data-b=\"y\">Yearly &minus;20%</button></div>\n<div class=\"row\">\n<div class=\"card\"><h4>Pro</h4><div class=\"p\"><em class=\"v\" data-m=\"29\" data-y=\"279\" style=\"font-style:normal\">29</em><span>/mo</span></div><a>Start</a></div>\n<div class=\"card\"><h4>Team</h4><div class=\"p\"><em class=\"v\" data-m=\"99\" data-y=\"948\" style=\"font-style:normal\">99</em><span>/mo</span></div><a>Start</a></div>\n</div></div>\n<script>(function(){var r=document.currentScript.parentNode.querySelector('.pto');var b=r.querySelectorAll('.sw button');var v=r.querySelectorAll('.v');b.forEach(function(x){x.onclick=function(){b.forEach(function(y){y.classList.remove('on')});x.classList.add('on');var mode=x.getAttribute('data-b');v.forEach(function(el){el.textContent=el.getAttribute(mode==='y'?'data-y':'data-m')});r.querySelectorAll('.p span').forEach(function(s){s.textContent=mode==='y'?'/yr':'/mo'})}})})();</script>"}