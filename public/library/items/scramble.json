{"id":"scramble","code":"<style>.sc{font:800 30px 'JetBrains Mono',ui-monospace,monospace;color:var(--accent,#3366FF);letter-spacing:.04em}</style>\n<div class=\"sc\" id=\"sc\"></div>\n<script>\nvar target=\"GOOD WORK. ENERGY\",chars=\"ABCDEFGHIJKLMNOPQRSTUVWXYZ#%&\",el=document.getElementById('sc');\nfunction scramble(){var it=0;var iv=setInterval(function(){\n el.textContent=target.split('').map(function(c,i){return i<it?c:(c===' '?' ':chars[Math.floor(Math.random()*chars.length)]);}).join('');\n it+=1/3;if(it>=target.length){el.textContent=target;clearInterval(iv);}},40);}\nscramble();setInterval(scramble,3500);\n</script>"}