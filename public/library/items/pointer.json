{"id":"pointer","code":"<style>.ptr{position:relative;width:230px;height:120px;border-radius:14px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);\n display:grid;place-items:center;color:var(--ink,#fff);font:700 15px Inter,sans-serif;cursor:none;overflow:hidden}\n.ptr .cur{position:absolute;width:0;height:0;pointer-events:none;transform:translate(-50%,-50%);opacity:0;transition:opacity .2s;\n border-left:14px solid var(--accent,#3366FF);border-top:9px solid transparent;border-bottom:9px solid transparent;filter:drop-shadow(0 2px 4px rgba(0,0,0,.5))}\n.ptr:hover .cur{opacity:1}</style>\n<div class=\"ptr\" id=\"ptr\">Move inside<span class=\"cur\" id=\"pcur\"></span></div>\n<script>var p=document.getElementById('ptr'),c=document.getElementById('pcur');p.addEventListener('pointermove',function(e){var r=p.getBoundingClientRect();c.style.left=(e.clientX-r.left)+'px';c.style.top=(e.clientY-r.top)+'px';});</script>"}