{"id":"aurorabg","code":"<style>.aur{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;background:#05060a}\n.aur i{position:absolute;width:200%;height:74px;filter:blur(26px);opacity:.7;border-radius:50%}\n.aur .a{background:var(--accent,#3366FF);top:-6px;left:-40px;animation:aurm 6s ease-in-out infinite}\n.aur .b{background:#6C2BD9;top:26px;left:-40px;animation:aurm 8s ease-in-out infinite reverse}\n@keyframes aurm{0%,100%{transform:translateX(-10%) skewY(-4deg)}50%{transform:translateX(10%) skewY(4deg)}}</style>\n<div class=\"aur\"><i class=\"a\"></i><i class=\"b\"></i></div>"}