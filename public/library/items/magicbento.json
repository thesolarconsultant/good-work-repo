{"id":"magicbento","code":"<style>.mbn{width:320px;display:grid;grid-template-columns:1fr 1fr;grid-auto-rows:78px;gap:10px;font-family:Inter,system-ui,sans-serif}\n.mbn .c{position:relative;border:1px solid var(--line,#262C34);border-radius:14px;background:var(--card,#171B22);overflow:hidden;padding:12px;cursor:pointer;transition:transform .18s}\n.mbn .c.wide{grid-column:span 2}\n.mbn .c .lbl{position:relative;z-index:3;color:var(--ink,#fff);font:700 12px Inter,sans-serif}\n.mbn .c .sub{position:relative;z-index:3;color:var(--body,#B6BDC8);font:400 10px Inter,sans-serif;margin-top:3px}\n.mbn .c .spot{position:absolute;inset:0;z-index:1;opacity:0;transition:opacity .3s;background:radial-gradient(170px circle at var(--mx,50%) var(--my,50%),rgba(51,102,255,.20),transparent 62%)}\n.mbn .c:hover .spot{opacity:1}\n.mbn .c .glow{position:absolute;inset:0;z-index:2;border-radius:14px;padding:1px;opacity:0;transition:opacity .3s;background:radial-gradient(150px circle at var(--mx,50%) var(--my,50%),var(--accent,#3366FF),transparent 60%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude}\n.mbn .c:hover .glow{opacity:1}\n.mbn .c i{position:absolute;z-index:1;width:3px;height:3px;border-radius:50%;background:var(--accent-2,#7A5CFF);opacity:0}\n.mbn .c:hover i{animation:mbtwk 1.3s ease-in-out infinite}\n.mbn .c i:nth-child(2){left:22%;top:30%;animation-delay:.1s}.mbn .c i:nth-child(3){left:70%;top:24%;animation-delay:.4s}.mbn .c i:nth-child(4){left:55%;top:68%;animation-delay:.7s}.mbn .c i:nth-child(5){left:33%;top:76%;animation-delay:1s}\n@keyframes mbtwk{0%,100%{opacity:0;transform:scale(.4)}50%{opacity:.9;transform:scale(1)}}\n.mbn .c:active{transform:scale(.98)}\n.mbn .c .rip{position:absolute;z-index:4;width:8px;height:8px;border-radius:50%;background:var(--accent,#3366FF);transform:translate(-50%,-50%);opacity:.55;pointer-events:none;animation:mbrip .6s ease-out forwards}\n@keyframes mbrip{to{transform:translate(-50%,-50%) scale(16);opacity:0}}\n@media(prefers-reduced-motion:reduce){.mbn .c:hover i{animation:none}}</style>\n<div class=\"mbn\">\n<div class=\"c wide\"><span class=\"spot\"></span><span class=\"glow\"></span><i></i><i></i><i></i><i></i><div class=\"lbl\">Magic Bento</div><div class=\"sub\">Hover for stars, spotlight and a glowing border.</div></div>\n<div class=\"c\"><span class=\"spot\"></span><span class=\"glow\"></span><i></i><i></i><i></i><i></i><div class=\"lbl\">Spotlight</div></div>\n<div class=\"c\"><span class=\"spot\"></span><span class=\"glow\"></span><i></i><i></i><i></i><i></i><div class=\"lbl\">Border Glow</div></div>\n<div class=\"c\"><span class=\"spot\"></span><span class=\"glow\"></span><i></i><i></i><i></i><i></i><div class=\"lbl\">Particles</div></div>\n<div class=\"c\"><span class=\"spot\"></span><span class=\"glow\"></span><i></i><i></i><i></i><i></i><div class=\"lbl\">Click Ripple</div></div>\n</div>\n<script>(function(){var root=document.currentScript.parentNode.querySelector('.mbn');root.querySelectorAll('.c').forEach(function(c){c.addEventListener('pointermove',function(e){var r=c.getBoundingClientRect();c.style.setProperty('--mx',(e.clientX-r.left)+'px');c.style.setProperty('--my',(e.clientY-r.top)+'px');});c.addEventListener('pointerdown',function(e){var r=c.getBoundingClientRect();var s=document.createElement('span');s.className='rip';s.style.left=(e.clientX-r.left)+'px';s.style.top=(e.clientY-r.top)+'px';c.appendChild(s);setTimeout(function(){s.remove();},600);});});})();</script>"}