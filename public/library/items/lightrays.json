{"id":"lightrays","code":"<style>.lr{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;background:#0b0e13;border:1px solid var(--line,#262C34)}\n.lr::before{content:\"\";position:absolute;top:-40%;left:50%;width:260px;height:260px;transform:translateX(-50%);\n background:conic-gradient(from 180deg at 50% 0,transparent 0 8deg,rgba(51,102,255,.28) 12deg,transparent 16deg,transparent 20deg,rgba(122,92,255,.22) 24deg,transparent 28deg,transparent 34deg,rgba(51,102,255,.28) 38deg,transparent 42deg);\n animation:lrm 6s linear infinite;transform-origin:50% 0}\n@keyframes lrm{to{transform:translateX(-50%) rotate(20deg)}}</style>\n<div class=\"lr\"></div>"}