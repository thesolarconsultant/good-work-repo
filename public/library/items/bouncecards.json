{"id":"bouncecards","code":"<style>.bcc{position:relative;width:190px;height:120px}\n.bcc .c{position:absolute;left:50%;bottom:0;width:66px;height:94px;margin-left:-33px;border-radius:12px;\n background:linear-gradient(150deg,#7A5CFF,var(--accent,#3366FF));border:2px solid #0B0E13;animation:bcin .6s cubic-bezier(.34,1.56,.64,1) both}\n@keyframes bcin{from{transform:translateY(34px) rotate(0) scale(.8);opacity:0}}</style>\n<div class=\"bcc\" id=\"bcc\"></div>\n<script>var bcc=document.getElementById('bcc'),rot=[-24,-8,8,24];\nfunction play(){bcc.innerHTML='';rot.forEach(function(r,i){var c=document.createElement('div');c.className='c';c.style.transform='rotate('+r+'deg) translateY(-'+Math.abs(r)*.5+'px)';c.style.animationDelay=(i*0.1)+'s';c.style.zIndex=i;bcc.appendChild(c);});}\nplay();setInterval(play,3000);</script>"}