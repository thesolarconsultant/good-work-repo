{"id":"cardswap","code":"<style>.csw{position:relative;width:150px;height:100px}\n.csw .cd{position:absolute;inset:0;border-radius:14px;display:grid;place-items:center;color:#fff;font:800 16px Inter,sans-serif;transition:.5s cubic-bezier(.22,1,.36,1);border:1px solid var(--line,#262C34)}</style>\n<div class=\"csw\" id=\"csw\"><div class=\"cd\" style=\"background:linear-gradient(135deg,#7A5CFF,#3366FF)\">Solar</div><div class=\"cd\" style=\"background:linear-gradient(135deg,#6C2BD9,#3366FF)\">Battery</div><div class=\"cd\" style=\"background:#171B22\">Heating</div></div>\n<script>function stack(){var cards=document.querySelectorAll('#csw .cd');cards.forEach(function(c,i){c.style.transform='translate('+(i*10)+'px,'+(i*-10)+'px) scale('+(1-i*.05)+')';c.style.zIndex=10-i;});}\nstack();setInterval(function(){var f=document.querySelector('#csw .cd');f.parentNode.appendChild(f);stack();},1600);</script>"}