{"id":"interactivegrid","code":"<style>.igp{display:grid;grid-template-columns:repeat(8,26px);grid-auto-rows:24px;gap:2px;padding:6px;border-radius:14px;background:#0b0e13;border:1px solid var(--line,#262C34)}\n.igp i{background:#12161c;border-radius:4px;transition:background .3s}\n.igp i:hover{background:var(--accent,#3366FF);transition:none}</style>\n<div class=\"igp\" id=\"igp\"></div>\n<script>var g=document.getElementById('igp'),s='';for(var i=0;i<32;i++)s+='<i></i>';g.innerHTML=s;</script>"}