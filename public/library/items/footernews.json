{"id":"footernews","code":"<style>.ftn{width:292px;padding:14px 0;border-top:1px solid var(--line,#262C34);font:500 11px Inter,system-ui,sans-serif;color:var(--body,#B6BDC8)}\n.ftn .lg{display:flex;align-items:center;gap:6px;font-weight:800;color:var(--ink,#fff);font-size:13px;margin-bottom:6px}.ftn .lg i{width:16px;height:16px;border-radius:5px;background:var(--accent,#3366FF)}\n.ftn p{margin:0 0 10px;font-size:10px;line-height:1.5}\n.ftn form{display:flex;gap:6px}.ftn input{flex:1;min-width:0;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:8px;color:var(--ink,#fff);font:500 11px Inter,sans-serif;padding:8px 10px;outline:none}.ftn input:focus{border-color:var(--accent,#3366FF)}\n.ftn button{background:var(--accent,#3366FF);color:#fff;border:0;border-radius:8px;font:700 11px Inter,sans-serif;padding:8px 14px;cursor:pointer;white-space:nowrap}</style>\n<div class=\"ftn\"><div class=\"lg\"><i></i>GOOD WORK.</div><p>Join the list — energy tips and product news, monthly.</p>\n<form id=\"ftnf\"><input type=\"email\" placeholder=\"Email address\" required><button id=\"ftnb\">Subscribe</button></form></div>\n<script>document.getElementById('ftnf').addEventListener('submit',function(e){e.preventDefault();var b=document.getElementById('ftnb');b.textContent='Subscribed ✓';this.querySelector('input').value='';setTimeout(function(){b.textContent='Subscribe';},1800);});</script>"}