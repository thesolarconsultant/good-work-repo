{"id":"wordrotate","code":"<style>.wro{font:800 30px Inter,sans-serif;color:var(--ink,#fff)}\n.wro .rot{color:var(--accent,#3366FF);display:inline-block;transition:opacity .3s,transform .3s}\n.wro .rot.out{opacity:0;transform:translateY(.4em)}</style>\n<div class=\"wro\">Made for <span class=\"rot\" id=\"wro\">solar</span></div>\n<script>var words=['solar','storage','heating','EV'],i=0,el=document.getElementById('wro');\nsetInterval(function(){el.classList.add('out');setTimeout(function(){i=(i+1)%words.length;el.textContent=words[i];el.classList.remove('out');},300);},2000);</script>"}