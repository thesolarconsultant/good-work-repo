{"id":"ripplebg","code":"<style>.rpl{position:relative;width:180px;height:130px;display:grid;place-items:center}\n.rpl i{position:absolute;border:1px solid var(--accent,#3366FF);border-radius:50%;width:40px;height:40px;opacity:0;animation:rplp 3s ease-out infinite}\n@keyframes rplp{0%{transform:scale(.4);opacity:.7}100%{transform:scale(3.4);opacity:0}}\n.rpl b{width:16px;height:16px;border-radius:50%;background:var(--accent,#3366FF);z-index:1;box-shadow:0 0 14px var(--accent,#3366FF)}</style>\n<div class=\"rpl\" id=\"rpl\"><b></b></div>\n<script>var r=document.getElementById('rpl');for(var i=0;i<4;i++){var c=document.createElement('i');c.style.animationDelay=(i*0.75)+'s';r.appendChild(c);}</script>"}