{"id":"optionwheel","code":"<style>.owl{width:220px;height:210px;position:relative;perspective:620px;font-family:Inter,system-ui,sans-serif;-webkit-mask:linear-gradient(transparent,#000 30%,#000 70%,transparent);mask:linear-gradient(transparent,#000 30%,#000 70%,transparent);cursor:grab;user-select:none;touch-action:none}\n.owl.drag{cursor:grabbing}\n.owl .ring{position:absolute;inset:0;transform-style:preserve-3d;transition:transform .35s cubic-bezier(.22,1,.36,1)}\n.owl .it{position:absolute;top:50%;left:0;right:0;margin-top:-16px;height:32px;display:flex;align-items:center;justify-content:center;font:700 19px Inter,sans-serif;color:#6B7482;backface-visibility:hidden;transition:color .2s}\n.owl .it.on{color:var(--ink,#fff)}\n.owl .marker{position:absolute;left:0;right:0;top:50%;height:34px;margin-top:-17px;border-top:1px solid var(--line,#262C34);border-bottom:1px solid var(--line,#262C34);pointer-events:none}\n.owl .marker::before{content:\"\";position:absolute;left:6px;top:50%;width:6px;height:6px;margin-top:-3px;border-radius:50%;background:var(--accent,#3366FF);box-shadow:0 0 8px var(--accent,#3366FF)}</style>\n<div class=\"owl\"><div class=\"marker\"></div><div class=\"ring\" id=\"owr\"></div></div>\n<script>(function(){var root=document.currentScript.parentNode.querySelector('.owl');var ring=root.querySelector('#owr');var items=['Ambient','House','Techno','Jazz','Lo-Fi','Synthwave'];var R=120,STEP=22,sel=2;items.forEach(function(t){var d=document.createElement('div');d.className='it';d.textContent=t;ring.appendChild(d);});var els=ring.querySelectorAll('.it');function render(){ring.style.transform='rotateX('+(sel*STEP)+'deg)';els.forEach(function(el,i){el.style.transform='rotateX('+(-i*STEP)+'deg) translateZ('+R+'px)';var d=Math.abs(i-sel);el.classList.toggle('on',d<0.5);el.style.opacity=Math.max(0,1-d*0.3);el.style.filter='blur('+Math.min(d*0.9,3)+'px)';});}function set(n){sel=Math.max(0,Math.min(items.length-1,n));render();}els.forEach(function(el,i){el.addEventListener('click',function(){set(i);});});root.addEventListener('wheel',function(e){e.preventDefault();set(sel+(e.deltaY>0?1:-1));},{passive:false});var down=false,sy=0,ss=0;root.addEventListener('pointerdown',function(e){down=true;sy=e.clientY;ss=sel;root.classList.add('drag');});window.addEventListener('pointermove',function(e){if(!down)return;set(Math.round(ss-(e.clientY-sy)/30));});window.addEventListener('pointerup',function(){down=false;root.classList.remove('drag');});render();})();</script>"}