{"id":"navbar","code":"<style>\n.nvb{width:300px;font-family:Inter,system-ui,sans-serif}\n.nvb .row{display:flex;align-items:center;height:64px;gap:6px;padding:0 8px;overflow:hidden}\n.nvb .logo{flex:none;width:26px;height:26px;border-radius:8px;background:var(--accent,#3366FF);transition:.35s cubic-bezier(.22,1,.36,1)}\n.nvb .pill{margin:0 auto;display:flex;align-items:center;background:var(--card,#171B22);border:1px solid transparent;border-radius:999px;padding:5px 6px;transition:.35s cubic-bezier(.22,1,.36,1)}\n.nvb .pill a{font:600 12px Inter,sans-serif;color:var(--ink,#F4F6F9);text-decoration:none;padding:6px 9px;border-radius:999px;transition:.2s}\n.nvb .pill a:hover{background:rgba(255,255,255,.07)}\n.nvb .getin{max-width:0;overflow:hidden;white-space:nowrap;transition:max-width .4s cubic-bezier(.22,1,.36,1)}\n.nvb .getin a{background:var(--accent,#3366FF);color:#fff;margin-left:4px}\n.nvb .cta0{flex:none;font:700 12px Inter,sans-serif;color:#fff;background:var(--accent,#3366FF);padding:8px 14px;border-radius:999px;white-space:nowrap;transition:.35s cubic-bezier(.22,1,.36,1)}\n.nvb.scrolled .pill{border-color:var(--line,#262C34);box-shadow:0 8px 24px -10px #000}\n.nvb.scrolled .getin{max-width:130px}\n.nvb.scrolled .logo{width:0;opacity:0;transform:translateY(-30px);margin-right:-6px}\n.nvb.scrolled .cta0{width:0;padding-left:0;padding-right:0;opacity:0;transform:translateY(-30px);overflow:hidden}</style>\n<div class=\"nvb\" id=\"nvb\"><div class=\"row\">\n <span class=\"logo\"></span>\n <div class=\"pill\"><a href=\"#\">Home</a><a href=\"#\">About</a><a href=\"#\">Services</a><a href=\"#\">Contact</a>\n  <span class=\"getin\"><a href=\"#\">Get Started</a></span></div>\n <span class=\"cta0\">Get Started</span></div></div>\n<script>var n=document.getElementById('nvb');setInterval(function(){n.classList.toggle('scrolled');},2200);</script>"}