{"id":"progressiveblur","code":"<style>.pbl{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden}\n.pbl .bg{position:absolute;inset:0;background:linear-gradient(135deg,#3366FF,#7A5CFF,#6C2BD9);font:900 22px Inter,sans-serif;color:#fff;display:grid;place-items:end center;padding-bottom:14px}\n.pbl .blur{position:absolute;left:0;right:0;bottom:0;height:60%;backdrop-filter:blur(8px);\n -webkit-mask:linear-gradient(transparent,#000);mask:linear-gradient(transparent,#000)}</style>\n<div class=\"pbl\"><div class=\"bg\">GOOD WORK.</div><div class=\"blur\"></div></div>"}