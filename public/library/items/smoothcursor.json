{"id":"smoothcursor","code":"<style>.scr{position:relative;width:230px;height:120px;border-radius:14px;background:repeating-linear-gradient(45deg,#171B22 0 12px,#12161c 12px 24px);\n display:grid;place-items:center;color:var(--ink,#fff);font:700 15px Inter,sans-serif;overflow:hidden;cursor:crosshair}\n.scr .dot{position:absolute;width:20px;height:20px;border-radius:50%;background:var(--accent,#3366FF);pointer-events:none;transform:translate(-50%,-50%);opacity:0;transition:opacity .2s}\n.scr:hover .dot{opacity:1}</style>\n<div class=\"scr\" id=\"scr\">Move around<span class=\"dot\" id=\"sdot\"></span></div>\n<script>var s=document.getElementById('scr'),d=document.getElementById('sdot'),tx=115,ty=60,x=115,y=60,on=false;\ns.addEventListener('pointermove',function(e){var r=s.getBoundingClientRect();tx=e.clientX-r.left;ty=e.clientY-r.top;on=true;});\n(function loop(){x+=(tx-x)*.12;y+=(ty-y)*.12;d.style.left=x+'px';d.style.top=y+'px';requestAnimationFrame(loop);})();</script>"}