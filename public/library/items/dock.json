{"id":"dock","code":"<style>.dock{display:flex;gap:10px;align-items:flex-end;padding:10px 14px;border-radius:16px;background:var(--card,#171B22);border:1px solid var(--line,#262C34)}\n.dock i{width:34px;height:34px;border-radius:10px;background:linear-gradient(180deg,#7A5CFF,var(--accent,#3366FF));transition:transform .18s ease,margin .18s ease;transform-origin:bottom;cursor:pointer}\n.dock i:hover{transform:scale(1.7) translateY(-4px);margin:0 12px}</style>\n<div class=\"dock\"><i></i><i></i><i></i><i></i><i></i></div>"}