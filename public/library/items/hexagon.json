{"id":"hexagon","code":"<style>.hex{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;border:1px solid var(--line,#262C34);background:#0b0e13}\n.hex::before{content:\"\";position:absolute;inset:0;opacity:.5;\n background:radial-gradient(circle farthest-side at 0 0,transparent 47%,rgba(51,102,255,.4) 48% 52%,transparent 53%) 0 0/26px 30px,\n radial-gradient(circle farthest-side at 0 0,transparent 47%,rgba(51,102,255,.4) 48% 52%,transparent 53%) 13px 15px/26px 30px}\n.hex i{position:absolute;width:140px;height:140px;border-radius:50%;background:radial-gradient(circle,rgba(51,102,255,.4),transparent 60%);animation:hexm 6s ease-in-out infinite}\n@keyframes hexm{0%{left:-40px;top:-30px}50%{left:150px;top:60px}100%{left:-40px;top:-30px}}</style>\n<div class=\"hex\"><i></i></div>"}