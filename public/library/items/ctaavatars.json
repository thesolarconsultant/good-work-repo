{"id":"ctaavatars","code":"<style>.ctv{width:290px;display:flex;flex-direction:column;gap:12px;font-family:Inter,system-ui,sans-serif}\n.ctv .av{display:flex}.ctv .av span{width:26px;height:26px;border-radius:50%;border:2px solid #0B0E13;margin-left:-8px;background:linear-gradient(135deg,#7A5CFF,var(--accent,#3366FF));display:grid;place-items:center;color:#fff;font:700 10px Inter,sans-serif}.ctv .av span:first-child{margin-left:0}\n.ctv h3{color:var(--ink,#fff);font:800 20px Inter,sans-serif;margin:0}.ctv p{color:var(--body,#B6BDC8);font:500 11px Inter,sans-serif;margin:2px 0 0}\n.ctv .btns{display:flex;gap:8px}.ctv a{padding:9px 18px;border-radius:999px;text-decoration:none;font:700 12px Inter,sans-serif}.ctv .p{background:var(--accent,#3366FF);color:#fff}.ctv .g{border:1px solid var(--line,#262C34);color:var(--ink,#fff)}</style>\n<div class=\"ctv\"><div class=\"av\"><span>J</span><span>K</span><span>A</span><span>S</span></div><div><h3>Join 5,000+ builders</h3><p>Get the latest updates and exclusive offers.</p></div><div class=\"btns\"><a class=\"p\">Get started</a><a class=\"g\">Learn more</a></div></div>"}