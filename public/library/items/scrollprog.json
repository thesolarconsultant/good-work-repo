{"id":"scrollprog","code":"<style>.spw{width:232px}.spbar{height:6px;border-radius:999px;background:var(--line,#262C34);overflow:hidden}\n.spbar b{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--accent,#3366FF),#7A5CFF);border-radius:999px}\n.spw p{font:600 12px Inter,sans-serif;color:#8A93A2;margin:9px 0 0}</style>\n<div class=\"spw\"><div class=\"spbar\"><b id=\"sp\"></b></div><p>Reading progress</p></div>\n<script>var b=document.getElementById('sp'),v=0;setInterval(function(){v=(v+1)%101;b.style.width=v+'%';},30);</script>"}