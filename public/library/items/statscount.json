{"id":"statscount","code":"<style>.stc{width:340px;font-family:Inter,system-ui,sans-serif;padding:16px 6px;text-align:center}\n.stc .k{color:var(--body,#B6BDC8);font:600 10px 'JetBrains Mono',monospace;letter-spacing:.06em}\n.stc h4{margin:8px 0 18px;color:var(--ink,#fff);font:700 20px Inter,sans-serif}\n.stc .grid{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px}\n.stc .cell b{display:block;color:var(--accent,#3366FF);font:700 26px 'JetBrains Mono',monospace}\n.stc .cell span{color:var(--body,#B6BDC8);font:400 10px Inter,sans-serif}</style>\n<div class=\"stc\"><div class=\"k\">STATS</div><h4>Our numbers speak for themselves</h4><div class=\"grid\"><div class=\"cell\"><b data-to=\"3400\">0</b><span>Downloads</span></div><div class=\"cell\"><b data-to=\"1500\">0</b><span>Users</span></div><div class=\"cell\"><b data-to=\"84\">0</b><span>Subscribers</span></div><div class=\"cell\"><b data-to=\"7\">0</b><span>Products</span></div></div></div>\n<script>(function(){var r=document.currentScript.parentNode.querySelector('.stc');var els=r.querySelectorAll('[data-to]');function fmt(v){return v>=1000?(v/1000).toFixed(1).replace('.0','')+'K':String(v);}function run(){els.forEach(function(el){var to=parseFloat(el.getAttribute('data-to')),plus=to>1000?'+':'',dur=1600,st=null;function step(ts){if(!st)st=ts;var p=Math.min((ts-st)/dur,1);el.textContent=fmt(Math.floor(p*to))+(p===1?plus:'');if(p<1)requestAnimationFrame(step);}requestAnimationFrame(step);});}var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){run();io.disconnect();}});});io.observe(r);})();</script>"}