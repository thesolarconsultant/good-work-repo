{"id":"featurescroll","code":"<style>.fscr{width:340px;display:flex;gap:16px;align-items:center;font-family:Inter,system-ui,sans-serif;padding:14px 6px}\n.fscr .tx{flex:1;display:flex;flex-direction:column;gap:10px}\n.fscr .dots{display:flex;gap:6px}.fscr .dots i{width:9px;height:9px;border-radius:50%;display:block}\n.fscr .dots i:nth-child(1){background:var(--accent,#3366FF)}.fscr .dots i:nth-child(2){background:var(--accent-2,#7A5CFF)}.fscr .dots i:nth-child(3){background:#5B5BFF}\n.fscr h1{margin:0;color:var(--ink,#fff);font:800 22px Inter,sans-serif;line-height:1.1}\n.fscr p{margin:0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif;line-height:1.5}\n.fscr .btns{display:flex;gap:8px;margin-top:2px}\n.fscr .btns a{font:700 11px Inter,sans-serif;padding:8px 14px;border-radius:8px;text-decoration:none}\n.fscr .btns .p{background:var(--accent,#3366FF);color:#fff}.fscr .btns .o{border:1px solid var(--line,#262C34);color:var(--ink,#fff)}\n.fscr .dev{width:120px;height:210px;border-radius:22px;border:6px solid #23282F;background:linear-gradient(160deg,#20252E,#0E1219);position:relative;overflow:hidden;flex:none;box-shadow:0 20px 50px -20px rgba(51,102,255,.4)}\n.fscr .dev::before{content:\"\";position:absolute;top:14px;left:14px;right:14px;height:60px;border-radius:10px;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF))}\n.fscr .dev::after{content:\"\";position:absolute;top:86px;left:14px;right:14px;bottom:14px;border-radius:10px;background:repeating-linear-gradient(#2A2F38 0 8px,transparent 8px 20px)}</style>\n<div class=\"fscr\"><div class=\"tx\"><div class=\"dots\"><i></i><i></i><i></i></div><h1>Scroll Feature</h1><p>Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptates quibusdam.</p><div class=\"btns\"><a class=\"p\">Learn More</a><a class=\"o\">Contact Us</a></div></div><div class=\"dev\"></div></div>"}