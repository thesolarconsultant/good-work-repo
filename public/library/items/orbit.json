{"id":"orbit","code":"<style>.orb2{position:relative;width:150px;height:150px}\n.orb2 .c{position:absolute;inset:0;margin:auto;width:32px;height:32px;border-radius:50%;background:var(--accent,#3366FF);box-shadow:0 0 16px var(--accent,#3366FF)}\n.orb2 .ring{position:absolute;border:1px dashed var(--line,#262C34);border-radius:50%;animation:orbspin linear infinite}\n.orb2 .ring b{position:absolute;top:-9px;left:50%;margin-left:-9px;width:18px;height:18px;border-radius:50%;background:var(--card,#171B22);border:1px solid var(--accent,#3366FF)}\n.orb2 .r1{inset:0;animation-duration:6s}.orb2 .r2{inset:28px;animation-duration:4s;animation-direction:reverse}\n@keyframes orbspin{to{transform:rotate(360deg)}}</style>\n<div class=\"orb2\"><span class=\"c\"></span><span class=\"ring r1\"><b></b></span><span class=\"ring r2\"><b></b></span></div>"}