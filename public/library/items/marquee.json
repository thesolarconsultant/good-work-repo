{"id":"marquee","code":"<style>.mq{overflow:hidden;width:280px;-webkit-mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);\n mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}\n.mq ul{display:flex;gap:34px;list-style:none;padding:0;margin:0;width:max-content;animation:mqmove 12s linear infinite}\n.mq li{font:800 18px Inter,sans-serif;color:var(--ink,#fff);opacity:.8;white-space:nowrap}\n@keyframes mqmove{to{transform:translateX(-50%)}}</style>\n<div class=\"mq\"><ul id=\"mq\"></ul></div>\n<script>var names=['Enphase','JA Solar','LONGi','Huawei','GoodWe','Tesla'];\ndocument.getElementById('mq').innerHTML=names.concat(names).map(function(n){return '<li>'+n+'</li>';}).join('');</script>"}