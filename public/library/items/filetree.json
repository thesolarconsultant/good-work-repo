{"id":"filetree","code":"<style>.ft{font:500 13px 'JetBrains Mono',ui-monospace,monospace;color:#c9d2e0;width:220px}\n.ft div{padding:3px 0;display:flex;gap:7px;align-items:center;opacity:0;animation:ftin .4s forwards}\n.ft .i{color:var(--accent,#3366FF)}\n@keyframes ftin{to{opacity:1}}</style>\n<div class=\"ft\" id=\"ft\"></div>\n<script>var rows=['📁 engine','&nbsp;&nbsp;<span class=\"i\">◆</span> brand.css','&nbsp;&nbsp;📁 motion','&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"i\">◆</span> goodwork-motion.js','&nbsp;&nbsp;📁 library'],ft=document.getElementById('ft');\nfunction play(){ft.innerHTML='';rows.forEach(function(r,i){var d=document.createElement('div');d.style.animationDelay=(i*0.2)+'s';d.innerHTML=r;ft.appendChild(d);});}\nplay();setInterval(play,3400);</script>"}