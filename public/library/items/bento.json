{"id":"bento","code":"<style>\n.bento{display:grid;grid-template-columns:1fr 1fr;gap:7px;width:296px;font-family:Inter,system-ui,sans-serif}\n.bento .cell{position:relative;overflow:hidden;border:1px solid var(--line,#262C34);border-radius:13px;background:var(--card,#171B22);\n min-height:84px;padding:9px 10px;display:flex;flex-direction:column;justify-content:flex-end;transition:transform .3s,border-color .3s}\n.bento .cell:hover{border-color:var(--accent,#3366FF);transform:translateY(-2px)}\n.bento .wide{grid-column:span 2;min-height:72px}\n.bento .bg{position:absolute;left:0;right:0;top:5px;bottom:40px;pointer-events:none;overflow:hidden;opacity:.85;\n -webkit-mask:linear-gradient(to top,transparent 12%,#000 78%);mask:linear-gradient(to top,transparent 12%,#000 78%);transition:transform .4s,opacity .4s}\n.bento .cell:hover .bg{opacity:1;transform:scale(1.05)}\n.bento .ic{width:22px;height:22px;border-radius:7px;background:var(--accent,#3366FF);display:grid;place-items:center;color:#fff;margin-bottom:5px;position:relative}\n.bento .ic svg{width:13px;height:13px}\n.bento h4{margin:0;font-size:12.5px;color:var(--ink,#F4F6F9);font-weight:700;position:relative}\n.bento p{margin:1px 0 0;font-size:10px;color:#8A93A2;line-height:1.35;position:relative}\n.bento .fchip{font:600 9px 'JetBrains Mono',ui-monospace,monospace;color:var(--ink,#F4F6F9);border:1px solid var(--line,#262C34);background:#12161c;border-radius:6px;padding:5px 7px;white-space:nowrap}\n.bento .ftrack{display:flex;gap:6px;width:max-content;padding-left:8px;animation:bfm 12s linear infinite}\n@keyframes bfm{to{transform:translateX(-50%)}}\n.bento .nrow{display:flex;align-items:center;gap:6px;background:#12161c;border:1px solid var(--line,#262C34);border-radius:7px;padding:4px 7px;margin:0 8px 4px;font:600 9px Inter,sans-serif;color:var(--ink,#F4F6F9)}\n.bento .nrow b{width:12px;height:12px;border-radius:50%;background:var(--accent,#3366FF);flex:none}\n.bento .beamsvg .base{stroke:var(--line,#262C34);stroke-width:2;fill:none}\n.bento .beamsvg .flow{stroke:var(--accent,#3366FF);stroke-width:2.5;fill:none;stroke-dasharray:10 90;animation:bbf 1.5s linear infinite}\n.bento .beamsvg .node{fill:#12161c;stroke:var(--line,#262C34)}\n@keyframes bbf{to{stroke-dashoffset:-100}}</style>\n<div class=\"bento\">\n <div class=\"cell\"><div class=\"bg\"><div class=\"ftrack\" id=\"bft\"></div></div>\n   <div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 3v5h5M8 3h6l5 5v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z\"/></svg></div>\n   <h4>Save your files</h4><p>Auto-saved as you type.</p></div>\n <div class=\"cell\"><div class=\"bg\" id=\"bnl\"></div>\n   <div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10 21h4\"/></svg></div>\n   <h4>Notifications</h4><p>Know when things happen.</p></div>\n <div class=\"cell wide\"><div class=\"bg\"><svg class=\"beamsvg\" width=\"100%\" height=\"100%\" viewBox=\"0 0 280 64\" preserveAspectRatio=\"none\">\n   <path class=\"base\" d=\"M28 32 H252\"/><path class=\"base\" d=\"M140 32 V8\"/><path class=\"base\" d=\"M140 32 V56\"/>\n   <path class=\"flow\" d=\"M28 32 H252\"/><circle class=\"node\" cx=\"28\" cy=\"32\" r=\"9\"/><circle class=\"node\" cx=\"252\" cy=\"32\" r=\"9\"/></svg></div>\n   <div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"18\" cy=\"5\" r=\"3\"/><circle cx=\"6\" cy=\"12\" r=\"3\"/><circle cx=\"18\" cy=\"19\" r=\"3\"/><path d=\"M8.6 13.5l6.8 4M15.4 6.5l-6.8 4\"/></svg></div>\n   <h4>Integrations</h4><p>100+ and counting.</p></div>\n</div>\n<script>\nvar files=['bitcoin.pdf','finances.xlsx','logo.svg','keys.gpg','seed.txt'];\ndocument.getElementById('bft').innerHTML=files.concat(files).map(function(f){return '<span class=\"fchip\">'+f+'</span>';}).join('');\nvar notif=['Payment received','New quote request','Panel activated'];\ndocument.getElementById('bnl').innerHTML=notif.map(function(n){return '<div class=\"nrow\"><b></b>'+n+'</div>';}).join('');\n</script>"}