{"id":"warpbg","code":"<style>.warp{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;background:#0b0e13;border:1px solid var(--line,#262C34)}\n.warp i{position:absolute;width:120px;height:120px;border-radius:50%;filter:blur(30px);opacity:.7}\n.warp .a{background:var(--accent,#3366FF);animation:wa 6s ease-in-out infinite}\n.warp .b{background:#7A5CFF;animation:wb 7s ease-in-out infinite}\n@keyframes wa{0%,100%{left:-30px;top:-30px}50%{left:130px;top:70px}}\n@keyframes wb{0%,100%{right:-30px;bottom:-30px}50%{right:130px;bottom:70px}}</style>\n<div class=\"warp\"><i class=\"a\"></i><i class=\"b\"></i></div>"}