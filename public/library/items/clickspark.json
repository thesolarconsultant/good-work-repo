{"id":"clickspark","code":"<style>.csp{position:relative;width:200px;height:110px;border-radius:14px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);display:grid;place-items:center;color:var(--ink,#fff);font:700 14px Inter,sans-serif;cursor:pointer;overflow:hidden}\n.csp .spk{position:absolute;width:2px;height:11px;background:var(--accent,#3366FF);pointer-events:none;border-radius:2px}</style>\n<div class=\"csp\" id=\"csp\">Click me</div>\n<script>var box=document.getElementById('csp');\nfunction spark(x,y){for(var i=0;i<9;i++){(function(a){var s=document.createElement('span');s.className='spk';s.style.left=x+'px';s.style.top=y+'px';box.appendChild(s);var t=0;var iv=setInterval(function(){t+=.08;var d=t*32;s.style.transform='translate('+Math.cos(a)*d+'px,'+Math.sin(a)*d+'px) rotate('+a+'rad)';s.style.opacity=1-t;if(t>=1){clearInterval(iv);s.remove();}},16);})(i/9*6.28);}}\nbox.addEventListener('pointerdown',function(e){var r=box.getBoundingClientRect();spark(e.clientX-r.left,e.clientY-r.top);});\nsetInterval(function(){spark(100,55);},1600);</script>"}