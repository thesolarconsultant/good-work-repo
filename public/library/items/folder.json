{"id":"folder","code":"<style>.fld{position:relative;width:92px;height:72px;cursor:pointer}\n.fld .back{position:absolute;left:0;right:0;top:12px;bottom:0;background:var(--accent,#3366FF);border-radius:5px 9px 9px 9px}\n.fld .back::before{content:\"\";position:absolute;top:-8px;left:0;width:38px;height:12px;background:var(--accent,#3366FF);border-radius:6px 6px 0 0}\n.fld .paper{position:absolute;left:9px;right:9px;top:8px;height:44px;background:#EEF1F5;border-radius:4px;transition:.35s;z-index:1}\n.fld .front{position:absolute;left:0;right:0;top:22px;bottom:0;background:#7A5CFF;border-radius:5px;transition:.35s;transform-origin:bottom;z-index:2}\n.fld:hover .front{transform:perspective(200px) rotateX(-38deg)}\n.fld:hover .paper{transform:translateY(-16px)}</style>\n<div class=\"fld\"><span class=\"back\"></span><span class=\"paper\"></span><span class=\"front\"></span></div>"}