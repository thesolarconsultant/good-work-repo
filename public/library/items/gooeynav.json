{"id":"gooeynav","code":"<style>.gnv{position:relative;display:flex;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:999px;padding:4px;font:700 12px Inter,sans-serif}\n.gnv a{position:relative;z-index:1;padding:8px 14px;color:var(--ink,#fff);text-decoration:none;transition:color .3s}\n.gnv .blob{position:absolute;top:4px;left:4px;height:calc(100% - 8px);background:var(--accent,#3366FF);border-radius:999px;transition:.45s cubic-bezier(.22,1,.36,1);z-index:0}</style>\n<div class=\"gnv\" id=\"gnv\"><span class=\"blob\" id=\"blob\"></span><a>Home</a><a>Work</a><a>About</a><a>Contact</a></div>\n<script>var nav=document.getElementById('gnv'),blob=document.getElementById('blob'),links=nav.querySelectorAll('a'),i=0;\nfunction move(){var a=links[i];blob.style.width=a.offsetWidth+'px';blob.style.left=a.offsetLeft+'px';links.forEach(function(l){l.style.color='';});a.style.color='#fff';i=(i+1)%links.length;}\nsetTimeout(move,120);setInterval(move,1400);</script>"}