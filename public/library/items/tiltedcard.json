{"id":"tiltedcard","code":"<style>.tilt{width:150px;height:110px;border-radius:16px;background:linear-gradient(150deg,#7A5CFF,var(--accent,#3366FF));\n display:grid;place-items:center;color:#fff;font:800 15px Inter,sans-serif;transition:transform .12s;box-shadow:0 20px 40px -18px var(--accent,#3366FF)}</style>\n<div class=\"tilt\" id=\"tilt\">Tilt me</div>\n<script>var c=document.getElementById('tilt');\nc.addEventListener('pointermove',function(e){var r=c.getBoundingClientRect();var rx=((e.clientY-r.top)/r.height-.5)*-24,ry=((e.clientX-r.left)/r.width-.5)*24;c.style.transform='perspective(500px) rotateX('+rx+'deg) rotateY('+ry+'deg)';});\nc.addEventListener('pointerleave',function(){c.style.transform='';});</script>"}