{"id":"scrollvelocity","code":"<style>.sv{overflow:hidden;width:280px;transform:skewY(-4deg);-webkit-mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}\n.sv div{display:flex;gap:24px;width:max-content;animation:svm 9s linear infinite;font:900 28px Inter,sans-serif;letter-spacing:-.02em}\n.sv b{color:var(--accent,#3366FF)}.sv i{color:var(--ink,#fff);font-style:normal}\n@keyframes svm{to{transform:translateX(-50%)}}</style>\n<div class=\"sv\"><div id=\"svd\"></div></div>\n<script>var w='<b>SOLAR</b><i>STORAGE</i><b>HEAT</b><i>SAVINGS</i>';document.getElementById('svd').innerHTML=w+w;</script>"}