{"id":"fcintegrations","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:200px;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center;gap:10px;-webkit-mask:linear-gradient(90deg,transparent,#000 22%,#000 78%,transparent);mask:linear-gradient(90deg,transparent,#000 22%,#000 78%,transparent)}\n.fc .mq{display:flex;gap:10px;width:max-content}\n.fc .mq.l{animation:fcml 14s linear infinite}.fc .mq.r{animation:fcmr 18s linear infinite}\n.fc .tile{width:44px;height:44px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card2,#20252E);position:relative;flex:none;display:grid;place-items:center;color:#fff;font-size:18px}\n.fc .tile::after{content:\"\";position:absolute;width:60%;height:60%;border-radius:50%;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF));filter:blur(12px);opacity:.7}\n.fc .tile span{position:relative;z-index:1}\n@keyframes fcml{to{transform:translateX(-54px)}}@keyframes fcmr{from{transform:translateX(-54px)}to{transform:translateX(0)}}\n@media(prefers-reduced-motion:reduce){.fc .mq{animation:none}}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}</style>\n<div class=\"fc\"><div class=\"stage\"><div class=\"mq l\"><span class=\"tile\"><span>🤝</span></span><span class=\"tile\"><span>🌐</span></span><span class=\"tile\"><span>📄</span></span><span class=\"tile\"><span>🛡️</span></span><span class=\"tile\"><span>📡</span></span><span class=\"tile\"><span>📊</span></span><span class=\"tile\"><span>🤝</span></span><span class=\"tile\"><span>🌐</span></span></div><div class=\"mq r\"><span class=\"tile\"><span>📊</span></span><span class=\"tile\"><span>🛡️</span></span><span class=\"tile\"><span>🌐</span></span><span class=\"tile\"><span>📄</span></span><span class=\"tile\"><span>📡</span></span><span class=\"tile\"><span>🤝</span></span><span class=\"tile\"><span>📊</span></span><span class=\"tile\"><span>🛡️</span></span></div></div><div class=\"foot\"><h2>Integrations</h2><p>Integrate with all your favourite apps</p></div></div>"}