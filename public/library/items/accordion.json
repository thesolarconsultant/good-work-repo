{"id":"accordion","code":"<style>.acc{width:280px;font-family:Inter,system-ui,sans-serif}\n.acc .item{border-bottom:1px solid var(--line,#262C34)}\n.acc .q{width:100%;text-align:left;background:none;border:0;color:var(--ink,#fff);font:700 14px Inter,sans-serif;padding:14px 0;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:10px}\n.acc .ch{width:18px;height:18px;flex:none;position:relative}\n.acc .ch::before,.acc .ch::after{content:\"\";position:absolute;top:50%;left:50%;width:12px;height:2px;background:var(--accent,#3366FF);transform:translate(-50%,-50%);border-radius:2px}\n.acc .ch::after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .3s cubic-bezier(.22,1,.36,1)}\n.acc .item.open .ch::after{transform:translate(-50%,-50%) rotate(0)}\n.acc .a{max-height:0;overflow:hidden;transition:max-height .35s cubic-bezier(.22,1,.36,1)}\n.acc .a p{margin:0 0 14px;font-size:13px;color:var(--body,#B6BDC8);line-height:1.55}</style>\n<div class=\"acc\" id=\"acc\">\n<div class=\"item\"><button class=\"q\">Is there a free plan?<span class=\"ch\"></span></button><div class=\"a\"><p>Yes — a free tier with the essentials, no card needed.</p></div></div>\n<div class=\"item\"><button class=\"q\">Can I change my plan?<span class=\"ch\"></span></button><div class=\"a\"><p>Anytime, in settings. Changes apply from your next billing date.</p></div></div>\n<div class=\"item\"><button class=\"q\">How do I cancel?<span class=\"ch\"></span></button><div class=\"a\"><p>One click in account settings — access lasts until the period ends.</p></div></div>\n</div>\n<script>var acc=document.getElementById('acc'),items=acc.querySelectorAll('.item');\nfunction openItem(it){items.forEach(function(i){i.classList.remove('open');i.querySelector('.a').style.maxHeight='0';});if(it){it.classList.add('open');var a=it.querySelector('.a');a.style.maxHeight=a.scrollHeight+'px';}}\nacc.querySelectorAll('.q').forEach(function(q){q.addEventListener('click',function(){var it=q.parentNode;openItem(it.classList.contains('open')?null:it);});});\nvar idx=0;function demo(){openItem(items[idx%items.length]);idx++;}demo();setInterval(demo,2200);</script>"}