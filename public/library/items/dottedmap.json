{"id":"dottedmap","code":"<style>.dmap{position:relative;width:240px;height:130px;border-radius:14px;background:#0b0e13;border:1px solid var(--line,#262C34);\n background-image:radial-gradient(rgba(160,170,190,.35) 1.1px,transparent 1.1px);background-size:12px 12px;overflow:hidden}\n.dmap i{position:absolute;width:8px;height:8px;border-radius:50%;background:var(--accent,#3366FF);box-shadow:0 0 8px var(--accent,#3366FF);animation:dmp 2s ease-in-out infinite}\n.dmap i:nth-child(2){animation-delay:.6s}.dmap i:nth-child(3){animation-delay:1.2s}\n@keyframes dmp{0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.5);opacity:1}}</style>\n<div class=\"dmap\"><i style=\"left:40px;top:40px\"></i><i style=\"left:120px;top:80px\"></i><i style=\"left:190px;top:35px\"></i></div>"}