{"id":"coverflow","code":"<style>.cov{display:flex;align-items:center;justify-content:center;gap:8px;perspective:700px;height:150px}\n.cov .c{width:64px;height:96px;border-radius:12px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);\n transition:.5s cubic-bezier(.22,1,.36,1);flex:none}\n.cov .c.l{transform:rotateY(38deg) scale(.82);opacity:.55}\n.cov .c.r{transform:rotateY(-38deg) scale(.82);opacity:.55}\n.cov .c.mid{transform:none;opacity:1;width:80px;height:112px;background:linear-gradient(160deg,#7A5CFF,var(--accent,#3366FF));\n border-color:transparent;box-shadow:0 16px 34px -12px var(--accent,#3366FF)}</style>\n<div class=\"cov\" id=\"cov\"><span class=\"c\"></span><span class=\"c\"></span><span class=\"c\"></span><span class=\"c\"></span><span class=\"c\"></span></div>\n<script>var cs=document.querySelectorAll('#cov .c'),mid=2;\nfunction go(){cs.forEach(function(c,x){c.className='c'+(x===mid?' mid':x<mid?' l':' r');});mid=(mid+1)%cs.length;}\ngo();setInterval(go,1400);</script>"}