{"id":"retrogrid","code":"<style>.rg2{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;border:1px solid var(--line,#262C34);\n background:linear-gradient(#0b0e13 40%,#1a0d06);perspective:120px}\n.rg2 .floor{position:absolute;bottom:0;left:-50%;width:200%;height:150%;transform-origin:bottom center;transform:rotateX(60deg);opacity:.6;\n background-image:linear-gradient(var(--accent,#3366FF) 1px,transparent 1px),linear-gradient(90deg,var(--accent,#3366FF) 1px,transparent 1px);\n background-size:24px 24px;animation:rg2m 1.2s linear infinite}\n@keyframes rg2m{to{background-position:0 24px}}</style>\n<div class=\"rg2\"><div class=\"floor\"></div></div>"}