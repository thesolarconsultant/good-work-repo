{"id":"pricingtable","code":"<style>.pcmp{font-family:Inter,system-ui,sans-serif;padding:12px 4px;width:320px}\n.pcmp table{width:100%;border-collapse:collapse;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:14px;overflow:hidden}\n.pcmp th,.pcmp td{padding:9px 10px;text-align:center;font:500 10px Inter,sans-serif;border-bottom:1px solid var(--line,#262C34)}\n.pcmp th{color:var(--ink,#fff);font-weight:800}.pcmp thead th:nth-child(2){color:var(--accent,#3366FF)}\n.pcmp td:first-child,.pcmp th:first-child{text-align:left;color:var(--body,#B6BDC8)}\n.pcmp .y{color:var(--accent,#3366FF);font-weight:800}.pcmp .n{color:#4A515C}\n.pcmp tr:last-child td{border-bottom:0}</style>\n<div class=\"pcmp\"><table>\n<thead><tr><th>Feature</th><th>Pro</th><th>Free</th></tr></thead>\n<tbody>\n<tr><td>Unlimited projects</td><td class=\"y\">&#10003;</td><td class=\"n\">&#10007;</td></tr>\n<tr><td>Priority support</td><td class=\"y\">&#10003;</td><td class=\"n\">&#10007;</td></tr>\n<tr><td>Custom domains</td><td class=\"y\">&#10003;</td><td class=\"n\">&#10007;</td></tr>\n<tr><td>Analytics</td><td class=\"y\">&#10003;</td><td class=\"y\">&#10003;</td></tr>\n<tr><td>Community access</td><td class=\"y\">&#10003;</td><td class=\"y\">&#10003;</td></tr>\n</tbody></table></div>"}