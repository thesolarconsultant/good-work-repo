{"id":"fcshare","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:200px;display:grid;place-items:center;position:relative}\n.fc .sc{position:absolute;width:190px;display:flex;gap:10px;align-items:center;border:1px solid var(--line,#262C34);border-radius:8px;padding:12px;background:var(--card2,#20252E);transition:.25s cubic-bezier(.22,1,.36,1)}\n.fc .sc .av{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF));flex:none}\n.fc .sc .ln{display:flex;flex-direction:column;gap:5px;flex:1}.fc .sc .ln i{height:6px;border-radius:99px;background:#3A424E;display:block}.fc .sc .ln i:nth-child(1){width:80%}.fc .sc .ln i:nth-child(2){width:100%}.fc .sc .ln i:nth-child(3){width:55%}\n.fc .a{transform:scale(.95);z-index:3}.fc .b{transform:scale(.95);z-index:2}\n.fc:hover .a{transform:translate(10px,25px) rotate(-2deg);box-shadow:0 20px 55px -18px rgba(122,92,255,.5)}\n.fc:hover .b{transform:translate(-10px,-25px) rotate(3deg);box-shadow:0 20px 55px -18px rgba(51,102,255,.5)}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}</style>\n<div class=\"fc\"><div class=\"stage\"><div class=\"sc a\"><span class=\"av\"></span><span class=\"ln\"><i></i><i></i><i></i></span></div><div class=\"sc b\"><span class=\"av\"></span><span class=\"ln\"><i></i><i></i><i></i></span></div></div><div class=\"foot\"><h2>Share</h2><p>Share results with your friends</p></div></div>"}