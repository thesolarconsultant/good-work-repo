{"id":"fcreply","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:200px;display:grid;place-items:center;position:relative}\n.fc .bub{position:absolute;width:210px;display:flex;gap:10px;border:1px solid var(--line,#262C34);border-radius:10px;padding:12px;background:var(--card2,#20252E);transition:.3s cubic-bezier(.22,1,.36,1)}\n.fc .bub .av{width:24px;height:24px;border-radius:50%;flex:none;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF))}\n.fc .bub h3{margin:0;color:var(--ink,#fff);font:600 12px Inter,sans-serif}.fc .bub p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 10px Inter,sans-serif}\n.fc .one{transform:translateY(0) scale(.97)}.fc:hover .one{transform:translateY(-45px) scale(1);box-shadow:0 20px 55px -20px rgba(122,92,255,.4)}\n.fc .two{transform:translateY(30px) scale(.97);opacity:0;z-index:3}.fc:hover .two{transform:translateY(10px) scale(1);opacity:1;box-shadow:0 20px 55px -20px rgba(51,102,255,.35)}\n.fc .tag{position:absolute;right:-6px;bottom:-8px;background:var(--accent,#3366FF);color:#fff;font:600 9px Inter,sans-serif;padding:2px 8px;border-radius:99px;opacity:0;transform:translate(8px,8px);transition:.3s .05s cubic-bezier(.22,1,.36,1)}\n.fc:hover .two .tag{opacity:1;transform:none}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}</style>\n<div class=\"fc\"><div class=\"stage\"><div class=\"bub one\"><span class=\"av\"></span><div><h3>Mary</h3><p>I think the design can be improved</p></div></div><div class=\"bub two\"><span class=\"av\"></span><div><h3>Joshua</h3><p>On it ✅</p></div><span class=\"tag\">sent</span></div></div><div class=\"foot\"><h2>Reply</h2><p>Reply to other creators in app</p></div></div>"}