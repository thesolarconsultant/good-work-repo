{"id":"herologos","code":"<style>.hlg{width:340px;font-family:Inter,system-ui,sans-serif;padding:16px 14px;display:flex;flex-direction:column;gap:13px}\n.hlg .kick{color:var(--body,#B6BDC8);font:600 9px 'JetBrains Mono',monospace;letter-spacing:.14em;text-transform:uppercase}\n.hlg h1{margin:0;color:var(--ink,#fff);font:600 20px Inter,sans-serif;line-height:1.2;letter-spacing:-.02em}\n.hlg .cta{display:flex;gap:10px}\n.hlg .cta a{font:700 12px Inter,sans-serif;padding:9px 18px;border-radius:99px;text-decoration:none}\n.hlg .cta .p{background:var(--accent,#3366FF);color:#fff}.hlg .cta .s{background:var(--card,#171B22);border:1px solid var(--line,#262C34);color:var(--ink,#fff)}\n.hlg .logos{display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-top:2px}\n.hlg .logos span{color:#8A93A2;font:800 13px Inter,sans-serif;letter-spacing:-.02em;opacity:.8}</style>\n<div class=\"hlg\"><span class=\"kick\">Browse new layouts</span><h1>A component library built to help teams design better web experiences.</h1><div class=\"cta\"><a class=\"p\">Get started</a><a class=\"s\">Contact us</a></div><div class=\"logos\"><span>Google</span><span>Microsoft</span><span>Amazon</span><span>Netflix</span><span>YouTube</span></div></div>"}