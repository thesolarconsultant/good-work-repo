{"id":"dotpattern","code":"<style>.dp{width:260px;height:150px;border-radius:14px;border:1px solid var(--line,#262C34);background-color:var(--card,#171B22);\n background-image:radial-gradient(var(--accent,#3366FF) 1.8px,transparent 1.9px);background-size:18px 18px;\n -webkit-mask:radial-gradient(ellipse at 50% 50%,#000 30%,rgba(0,0,0,.35) 85%);mask:radial-gradient(ellipse at 50% 50%,#000 30%,rgba(0,0,0,.35) 85%);\n animation:dpm 6s linear infinite}\n@keyframes dpm{to{background-position:18px 18px}}</style>\n<div class=\"dp\"></div>"}