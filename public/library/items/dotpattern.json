{"id":"dotpattern","code":"<style>.dp{width:240px;height:130px;border-radius:14px;background:var(--card,#171B22);\n background-image:radial-gradient(var(--accent,#3366FF) 1.4px,transparent 1.4px);background-size:18px 18px;\n -webkit-mask:radial-gradient(circle at 50% 50%,#000,transparent 72%);mask:radial-gradient(circle at 50% 50%,#000,transparent 72%);\n animation:dpm 6s linear infinite}\n@keyframes dpm{to{background-position:18px 18px}}</style>\n<div class=\"dp\"></div>"}