{"id":"bars","code":"<style>.bc{display:flex;align-items:flex-end;gap:8px;height:92px}\n.bc span{width:20px;border-radius:6px 6px 3px 3px;height:0;\n background:linear-gradient(180deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF));transition:height .8s cubic-bezier(.22,1,.36,1)}</style>\n<div class=\"bc\" id=\"bc\"></div>\n<script>var h=[40,66,52,88,72,96],c=document.getElementById('bc');\nc.innerHTML=h.map(function(){return '<span></span>';}).join('');var bars=c.querySelectorAll('span');\nfunction p(){bars.forEach(function(b,i){b.style.height='0';setTimeout(function(){b.style.height=h[i]+'%';},60+i*80);});}\np();setInterval(p,3000);</script>"}