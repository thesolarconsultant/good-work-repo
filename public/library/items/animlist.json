{"id":"animlist","code":"<style>.al{display:flex;flex-direction:column;gap:8px;width:232px}\n.al .item{display:flex;align-items:center;gap:10px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:12px;\n padding:10px 12px;font:600 13px Inter,sans-serif;color:var(--ink,#fff);animation:alin .5s cubic-bezier(.22,1,.36,1)}\n.al .item b{width:22px;height:22px;border-radius:50%;background:var(--accent,#3366FF);flex:none}\n@keyframes alin{from{opacity:0;transform:translateY(-14px) scale(.97)}to{opacity:1;transform:none}}</style>\n<div class=\"al\" id=\"al\"></div>\n<script>var msgs=['New quote request','Payment received','Install booked','Panel activated'],al=document.getElementById('al'),k=0;\nfunction add(){var d=document.createElement('div');d.className='item';d.innerHTML='<b></b>'+msgs[k%msgs.length];al.prepend(d);k++;while(al.children.length>4)al.lastChild.remove();}\nadd();add();add();setInterval(add,1500);</script>"}