{"id":"herocentered","code":"<style>.hcn{width:340px;font-family:Inter,system-ui,sans-serif;padding:18px 14px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px}\n.hcn h1{margin:0;color:var(--ink,#fff);font:700 24px Inter,sans-serif;line-height:1.12;letter-spacing:-.02em}\n.hcn p{margin:0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif;max-width:270px;line-height:1.5}\n.hcn .cta{display:flex;gap:10px}\n.hcn .cta a{font:700 12px Inter,sans-serif;padding:9px 18px;border-radius:99px;text-decoration:none}\n.hcn .cta .p{background:var(--accent,#3366FF);color:#fff}.hcn .cta .s{background:var(--card,#171B22);border:1px solid var(--line,#262C34);color:var(--ink,#fff)}\n.hcn .img{width:300px;height:120px;margin-top:4px;border-radius:16px;border:1px solid var(--line,#262C34);background:linear-gradient(160deg,#20252E,#0E1219);position:relative;overflow:hidden}\n.hcn .img::before{content:\"\";position:absolute;top:0;left:20%;right:20%;height:50%;background:var(--accent,#3366FF);filter:blur(45px);opacity:.4}\n.hcn .img::after{content:\"\";position:absolute;inset:16px;border-radius:8px;background:repeating-linear-gradient(#2A2F38 0 7px,transparent 7px 20px)}</style>\n<div class=\"hcn\"><h1>GOOD WORK. Design Studio</h1><p>Build a fast, animated marketing website that converts visitors into customers.</p><div class=\"cta\"><a class=\"p\">Start free trial</a><a class=\"s\">See a demo</a></div><div class=\"img\"></div></div>"}