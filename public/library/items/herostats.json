{"id":"herostats","code":"<style>.hst{width:340px;font-family:Inter,system-ui,sans-serif;padding:18px 14px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px}\n.hst h1{margin:0;color:var(--ink,#fff);font:700 22px Inter,sans-serif;line-height:1.15;letter-spacing:-.02em;max-width:290px}\n.hst h1 span{color:#6B7482;font-weight:600}\n.hst .cta{display:flex;gap:10px}\n.hst .cta a{font:700 12px Inter,sans-serif;padding:9px 18px;border-radius:99px;text-decoration:none}\n.hst .cta .p{background:var(--accent,#3366FF);color:#fff}.hst .cta .s{background:var(--card,#171B22);border:1px solid var(--line,#262C34);color:var(--ink,#fff)}\n.hst .stats{display:flex;justify-content:space-between;width:100%;max-width:290px;gap:8px}\n.hst .st{display:flex;flex-direction:column;gap:2px}\n.hst .st b{color:var(--accent,#3366FF);font:600 20px 'JetBrains Mono',monospace}\n.hst .st span{color:var(--body,#B6BDC8);font:400 9px Inter,sans-serif}</style>\n<div class=\"hst\"><h1>GOOD WORK. Design Studio: <span>a site that converts.</span></h1><div class=\"cta\"><a class=\"p\">Start free trial</a><a class=\"s\">See a demo</a></div><div class=\"stats\"><div class=\"st\"><b data-to=\"20\" data-suf=\"k+\">0</b><span>Happy users</span></div><div class=\"st\"><b data-to=\"5\" data-suf=\"k+\">0</b><span>Sections</span></div><div class=\"st\"><b data-to=\"100\" data-suf=\"x\">0</b><span>Faster dev</span></div><div class=\"st\"><b data-pre=\"$\" data-to=\"1\" data-suf=\"M\">0</b><span>Revenue</span></div></div></div>\n<script>(function(){var r=document.currentScript.parentNode.querySelector('.hst');var els=r.querySelectorAll('[data-to]');function run(){els.forEach(function(el){var to=parseFloat(el.getAttribute('data-to')),pre=el.getAttribute('data-pre')||'',suf=el.getAttribute('data-suf')||'',dur=1400,st=null;function step(ts){if(!st)st=ts;var p=Math.min((ts-st)/dur,1);el.textContent=pre+Math.floor(p*to)+(p===1?suf:'');if(p<1)requestAnimationFrame(step);}requestAnimationFrame(step);});}var io=new IntersectionObserver(function(e){e.forEach(function(x){if(x.isIntersecting){run();io.disconnect();}});});io.observe(r);})();</script>"}