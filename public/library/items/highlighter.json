{"id":"highlighter","code":"<style>.hlt{font:800 26px Inter,sans-serif;color:var(--ink,#fff)}\n.hlt mark{background:linear-gradient(120deg,var(--accent,#3366FF),var(--accent,#3366FF)) no-repeat;background-size:0 100%;color:inherit;padding:2px 4px;border-radius:4px;animation:hltm 1.4s cubic-bezier(.22,1,.36,1) forwards}\n@keyframes hltm{to{background-size:100% 100%}}</style>\n<div class=\"hlt\" id=\"hlt\">Everyone deserves <mark>fair energy</mark></div>\n<script>var el=document.getElementById('hlt');setInterval(function(){var n=el.cloneNode(true);el.parentNode.replaceChild(n,el);el=n;},3000);</script>"}