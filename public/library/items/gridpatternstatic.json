{"id":"gridpatternstatic","code":"<style>.gps{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;border:1px solid var(--line,#262C34);\n background-color:#0b0e13;background-image:linear-gradient(var(--line,#262C34) 1px,transparent 1px),linear-gradient(90deg,var(--line,#262C34) 1px,transparent 1px);background-size:22px 22px;\n -webkit-mask:radial-gradient(circle at 50% 50%,#000,transparent 84%);mask:radial-gradient(circle at 50% 50%,#000,transparent 84%)}\n.gps i{position:absolute;width:20px;height:20px;background:rgba(51,102,255,.5);border-radius:3px}\n.gps i:nth-child(1){left:45px;top:23px}.gps i:nth-child(2){left:133px;top:67px}.gps i:nth-child(3){left:89px;top:89px}</style>\n<div class=\"gps\"><i></i><i></i><i></i></div>"}