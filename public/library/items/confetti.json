{"id":"confetti","code":"<style>.cfwrap{position:relative;display:grid;place-items:center}\n.cf{position:relative;z-index:1;border:0;cursor:pointer;color:#fff;font:800 15px Inter,sans-serif;background:var(--accent,#3366FF);padding:15px 30px;border-radius:12px}\n.cfc{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);pointer-events:none}</style>\n<div class=\"cfwrap\"><canvas class=\"cfc\" id=\"cfc\" width=\"360\" height=\"200\"></canvas><button class=\"cf\" id=\"cf\">Celebrate &#127881;</button></div>\n<script>var cv=document.getElementById('cfc'),x=cv.getContext('2d'),parts=[],cols=['#3366FF','#7A5CFF','#FFD36A','#fff'];\nfunction burst(){for(var i=0;i<70;i++){var a=Math.random()*6.28,s=Math.random()*5+2;parts.push({x:180,y:100,vx:Math.cos(a)*s,vy:Math.sin(a)*s-2,r:Math.random()*4+2,c:cols[i%4],life:60});}}\n(function loop(){x.clearRect(0,0,360,200);for(var i=parts.length-1;i>=0;i--){var p=parts[i];p.vy+=.12;p.x+=p.vx;p.y+=p.vy;p.life--;x.globalAlpha=Math.max(0,p.life/60);x.fillStyle=p.c;x.fillRect(p.x,p.y,p.r,p.r);if(p.life<=0)parts.splice(i,1);}x.globalAlpha=1;requestAnimationFrame(loop);})();\ndocument.getElementById('cf').addEventListener('click',burst);burst();setInterval(burst,2600);</script>"}