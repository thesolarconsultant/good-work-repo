{"id":"pulse","code":"<style>.pl{position:relative;border:0;cursor:pointer;color:#fff;font:800 15px Inter,sans-serif;background:var(--accent,#3366FF);padding:15px 30px;border-radius:999px}\n.pl::before{content:\"\";position:absolute;inset:0;border-radius:999px;background:var(--accent,#3366FF);z-index:-1;animation:plp 1.8s ease-out infinite}\n@keyframes plp{0%{transform:scale(1);opacity:.55}100%{transform:scale(1.55);opacity:0}}</style>\n<button class=\"pl\">Join now</button>"}