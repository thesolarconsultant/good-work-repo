{"id":"magiccard","code":"<style>.mc{position:relative;width:220px;height:120px;border-radius:16px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);\n overflow:hidden;display:grid;place-items:center;color:var(--ink,#fff);font:700 15px Inter,sans-serif}\n.mc .spot{position:absolute;width:220px;height:220px;border-radius:50%;left:50%;top:50%;transform:translate(-50%,-50%);pointer-events:none;\n background:radial-gradient(circle,rgba(51,102,255,.45),transparent 60%);opacity:0;transition:opacity .2s}\n.mc:hover .spot{opacity:1}</style>\n<div class=\"mc\" id=\"mc\"><span class=\"spot\" id=\"spot\"></span>Hover me</div>\n<script>var c=document.getElementById('mc'),s=document.getElementById('spot');\nc.addEventListener('pointermove',function(e){var r=c.getBoundingClientRect();s.style.left=(e.clientX-r.left)+'px';s.style.top=(e.clientY-r.top)+'px';});</script>"}