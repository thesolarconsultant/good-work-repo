{"id":"fcshowcase","code":"<style>.fc{width:320px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer;display:flex;flex-direction:column}\n.fc .top{padding:20px;display:flex;flex-direction:column;gap:12px}\n.fc .top h2{margin:0;color:var(--ink,#fff);font:700 18px Inter,sans-serif;line-height:1.3}\n.fc .top a{color:var(--accent,#3366FF);font:500 12px Inter,sans-serif;text-decoration:none}\n.fc .grid{position:relative;height:150px;overflow:hidden;-webkit-mask:linear-gradient(transparent,#000 40%);mask:linear-gradient(transparent,#000 40%)}\n.fc .grid .rot{position:absolute;top:14px;left:20px;right:-30px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;transform:rotate(-14deg)}\n.fc .g{display:flex;flex-direction:column;align-items:center;gap:5px;border:1px solid var(--line,#262C34);border-radius:8px;padding:9px;background:var(--card2,#20252E);opacity:0;transform:translateY(18px) scale(.96);animation:fcpop .4s cubic-bezier(.22,1,.36,1) forwards}\n.fc .g:nth-child(2){animation-delay:.05s}.fc .g:nth-child(3){animation-delay:.1s}.fc .g:nth-child(4){animation-delay:.15s}.fc .g:nth-child(5){animation-delay:.2s}.fc .g:nth-child(6){animation-delay:.25s}\n@keyframes fcpop{to{opacity:1;transform:none}}\n@media(prefers-reduced-motion:reduce){.fc .g{animation:none;opacity:1;transform:none}}\n.fc .g .av{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF))}\n.fc .g small{color:var(--body,#B6BDC8);font:500 9px Inter,sans-serif}.fc .g em{font-style:normal;background:var(--accent,#3366FF);color:#fff;font:600 8px Inter,sans-serif;padding:1px 6px;border-radius:99px}</style>\n<div class=\"fc\"><div class=\"top\"><h2>Build amazing websites with all your friends.</h2><a>Check out our showcase →</a></div><div class=\"grid\"><div class=\"rot\"><div class=\"g\"><span class=\"av\"></span><small>Tom</small><em>Site</em></div><div class=\"g\"><span class=\"av\"></span><small>Chris</small><em>Site</em></div><div class=\"g\"><span class=\"av\"></span><small>PJ</small><em>Site</em></div><div class=\"g\"><span class=\"av\"></span><small>Scott</small><em>Site</em></div><div class=\"g\"><span class=\"av\"></span><small>Ezra</small><em>Site</em></div><div class=\"g\"><span class=\"av\"></span><small>Ivey</small><em>Site</em></div></div></div></div>"}