{"id":"borderbeam","code":"<style>@property --bb{syntax:'<angle>';inherits:false;initial-value:0deg}\n.bbcard{position:relative;width:210px;height:118px;border-radius:16px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);\n display:grid;place-items:center;color:var(--ink,#fff);font:700 15px Inter,sans-serif}\n.bbcard::before{content:\"\";position:absolute;inset:-1px;border-radius:16px;padding:2px;\n background:conic-gradient(from var(--bb),transparent 0 82%,var(--accent,#3366FF) 92%,#fff 97%,transparent 100%);\n -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;\n animation:bbspin 3s linear infinite}\n@keyframes bbspin{to{--bb:360deg}}</style>\n<div class=\"bbcard\">Border Beam</div>"}