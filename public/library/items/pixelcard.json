{"id":"pixelcard","code":"<style>.pxc{position:relative;width:150px;height:100px;border-radius:14px;overflow:hidden;border:1px solid var(--line,#262C34);\n background:var(--card,#171B22);display:grid;place-items:center;color:var(--ink,#fff);font:700 14px Inter,sans-serif}\n.pxc .px{position:absolute;inset:0;display:grid;grid-template-columns:repeat(10,1fr);grid-template-rows:repeat(7,1fr)}\n.pxc .px i{background:var(--accent,#3366FF);opacity:0;transition:opacity .3s}\n.pxc:hover .px i{opacity:1}\n.pxc span{position:relative;z-index:1}</style>\n<div class=\"pxc\"><div class=\"px\" id=\"pxc\"></div><span>Hover</span></div>\n<script>var g=document.getElementById('pxc'),s='';for(var i=0;i<70;i++)s+='<i style=\"transition-delay:'+(Math.random()*0.4).toFixed(2)+'s\"></i>';g.innerHTML=s;</script>"}