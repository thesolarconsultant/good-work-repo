{"id":"fillslide","code":"<style>.fb{--c:var(--accent,#3366FF);position:relative;border:2px solid var(--c);background:transparent;color:var(--c);\n cursor:pointer;font:700 15px Inter,sans-serif;padding:14px 26px;border-radius:999px;overflow:hidden;transition:color .3s}\n.fb span{position:relative;z-index:1;display:inline-flex;gap:.5em;align-items:center}\n.fb::before{content:\"\";position:absolute;inset:0;background:var(--c);transform:translateX(-101%);\n transition:transform .35s cubic-bezier(.22,1,.36,1);z-index:0}\n.fb:hover{color:#fff}.fb:hover::before{transform:none}\n.fb svg{transition:transform .3s}.fb:hover svg{transform:translateX(4px)}</style>\n<button class=\"fb\"><span>Learn more <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg></span></button>"}