{"id":"footercta","code":"<style>.ftc{width:292px;font:600 11px Inter,system-ui,sans-serif}\n.ftc .q{display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;padding:16px 0;border-bottom:1px dashed var(--line,#262C34)}\n.ftc .q h3{color:var(--ink,#fff);font:800 18px Inter,sans-serif;margin:0}\n.ftc .q .b{display:flex;gap:8px}.ftc .q .b a{padding:8px 15px;border-radius:999px;text-decoration:none;font-weight:700;font-size:11px;cursor:pointer}\n.ftc .q .b .p{background:var(--accent,#3366FF);color:#fff}.ftc .q .b .g{border:1px solid var(--line,#262C34);color:var(--ink,#fff)}\n.ftc .bot{display:flex;align-items:center;justify-content:space-between;padding:12px 0;color:var(--body,#B6BDC8);font-size:10px}\n.ftc .lg{display:flex;align-items:center;gap:6px;font-weight:800;color:var(--ink,#fff);font-size:13px}.ftc .lg i{width:16px;height:16px;border-radius:5px;background:var(--accent,#3366FF)}</style>\n<div class=\"ftc\"><div class=\"q\"><h3>Still have questions?</h3><div class=\"b\"><a class=\"p\">Let's chat →</a><a class=\"g\">Request demo</a></div></div>\n<div class=\"bot\"><span class=\"lg\"><i></i>GOOD WORK.</span><span>© GOOD WORK.. All rights reserved.</span></div></div>"}