{"id":"themetoggler","code":"<style>.ttg{width:52px;height:52px;border:0;background:transparent;cursor:pointer;position:relative}\n.ttg .b{position:absolute;inset:8px;border-radius:50%;background:var(--accent,#3366FF);transition:.5s;box-shadow:0 0 18px var(--accent,#3366FF)}\n.ttg .b::after{content:\"\";position:absolute;top:-4px;right:-4px;width:28px;height:28px;border-radius:50%;background:#0B0E13;transform:scale(0);transition:.5s}\n.ttg.moon .b{background:#cdd3e0;box-shadow:0 0 18px rgba(205,211,224,.5)}\n.ttg.moon .b::after{transform:scale(1)}</style>\n<button class=\"ttg\" id=\"ttg\"><span class=\"b\"></span></button>\n<script>var t=document.getElementById('ttg');setInterval(function(){t.classList.toggle('moon');},2000);t.addEventListener('click',function(){t.classList.toggle('moon');});</script>"}