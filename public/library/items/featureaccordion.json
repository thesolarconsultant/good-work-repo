{"id":"featureaccordion","code":"<style>.fsec{width:340px;display:flex;gap:14px;font-family:Inter,system-ui,sans-serif;padding:14px 6px;align-items:stretch}\n.fsec .rail{width:150px;display:flex;flex-direction:column;gap:6px}\n.fsec .fi{position:relative;text-align:left;background:none;border:0;cursor:pointer;padding:8px 10px 8px 16px;color:var(--body,#B6BDC8)}\n.fsec .fi .bar{position:absolute;left:0;top:6px;bottom:6px;width:2px;border-radius:2px;background:var(--line,#262C34);overflow:hidden}\n.fsec .fi .bar i{position:absolute;top:0;left:0;width:100%;height:0;background:var(--accent,#3366FF)}\n.fsec .fi:not(.on) .bar i{transition:none}\n.fsec .fi.on .bar i{height:100%;transition:height 4s linear}\n.fsec .fi h3{margin:0;font:700 13px Inter,sans-serif;color:var(--body,#B6BDC8);transition:.2s}\n.fsec .fi.on h3{color:var(--ink,#fff)}\n.fsec .fi p{margin:5px 0 0;font:400 10px Inter,sans-serif;line-height:1.4;max-height:0;opacity:0;overflow:hidden;transition:.3s}\n.fsec .fi.on p{max-height:60px;opacity:1}\n.fsec .shot{flex:1;position:relative;border:1px solid var(--line,#262C34);border-radius:12px;overflow:hidden;min-height:150px}\n.fsec .pane{position:absolute;inset:0;display:grid;place-items:center;opacity:0;transform:scale(.98);transition:.35s;color:#fff;font:700 14px Inter,sans-serif;text-shadow:0 1px 6px rgba(0,0,0,.4)}\n.fsec .pane.on{opacity:1;transform:none}\n.fsec .p0{background:linear-gradient(135deg,#7A5CFF,#C0392B)}.fsec .p1{background:linear-gradient(135deg,#5B5BFF,#1E9E6A)}.fsec .p2{background:linear-gradient(135deg,#F5A623,#3366FF)}.fsec .p3{background:linear-gradient(135deg,#7C4DFF,#FF2E88)}</style>\n<div class=\"fsec\">\n<div class=\"rail\">\n<button class=\"fi on\"><span class=\"bar\"><i></i></span><h3>Innovative Design</h3><p>Visually appealing and highly functional.</p></button>\n<button class=\"fi\"><span class=\"bar\"><i></i></span><h3>User-Centric Approach</h3><p>We prioritise your needs in every decision.</p></button>\n<button class=\"fi\"><span class=\"bar\"><i></i></span><h3>Seamless Integration</h3><p>Slots into your existing systems smoothly.</p></button>\n<button class=\"fi\"><span class=\"bar\"><i></i></span><h3>Continuous Improvement</h3><p>Always updating to give you the best.</p></button>\n</div>\n<div class=\"shot\"><div class=\"pane p0 on\">Innovative Design</div><div class=\"pane p1\">User-Centric</div><div class=\"pane p2\">Seamless Integration</div><div class=\"pane p3\">Continuous Improvement</div></div>\n</div>\n<script>(function(){var r=document.currentScript.parentNode.querySelector('.fsec');var items=r.querySelectorAll('.fi');var panes=r.querySelectorAll('.pane');var i=0,t;function go(n){i=n;items.forEach(function(x,k){x.classList.toggle('on',k===i)});panes.forEach(function(x,k){x.classList.toggle('on',k===i)});}function reset(){clearInterval(t);t=setInterval(function(){go((i+1)%items.length)},4000);}items.forEach(function(x,k){x.onclick=function(){go(k);reset();}});go(0);reset();})();</script>"}