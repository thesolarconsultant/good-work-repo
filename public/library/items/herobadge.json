{"id":"herobadge","code":"<style>.hbd{width:340px;font-family:Inter,system-ui,sans-serif;padding:18px 14px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px}\n.hbd .pill{display:inline-flex;align-items:center;gap:8px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:99px;padding:4px 12px 4px 4px;color:var(--body,#B6BDC8);font:500 10px Inter,sans-serif;cursor:pointer}\n.hbd .pill b{background:var(--accent,#3366FF);color:#fff;font:600 9px Inter,sans-serif;padding:2px 8px;border-radius:99px}\n.hbd .pill .ar{transition:.2s}.hbd .pill:hover .ar{transform:translateX(3px)}\n.hbd h1{margin:0;font:600 22px Inter,sans-serif;line-height:1.2;letter-spacing:-.02em}\n.hbd h1 b{color:var(--ink,#fff);font-weight:700}.hbd h1 span{color:#6B7482}\n.hbd .cta{display:flex;gap:10px}\n.hbd .cta a{font:700 12px Inter,sans-serif;padding:9px 18px;border-radius:99px;text-decoration:none}\n.hbd .cta .p{background:var(--accent,#3366FF);color:#fff}.hbd .cta .s{background:var(--card,#171B22);border:1px solid var(--line,#262C34);color:var(--ink,#fff)}\n.hbd .trust{display:flex;gap:16px;color:var(--body,#B6BDC8);font:500 10px Inter,sans-serif}\n.hbd .trust span{display:flex;align-items:center;gap:5px}.hbd .trust b{color:var(--accent,#3366FF)}</style>\n<div class=\"hbd\"><span class=\"pill\"><b>Update</b> Browse new layouts <span class=\"ar\">→</span></span><h1><b>GOOD WORK. Design Studio:</b> <span>build a fast, animated site that converts.</span></h1><div class=\"cta\"><a class=\"p\">Start free trial</a><a class=\"s\">See a demo</a></div><div class=\"trust\"><span><b>✓</b> 30 days free</span><span><b>✓</b> 3k+ sections</span></div></div>"}