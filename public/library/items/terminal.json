{"id":"terminal","code":"<style>.term{width:250px;background:#0a0d13;border:1px solid var(--line,#262C34);border-radius:10px;overflow:hidden;font:500 12px 'JetBrains Mono',ui-monospace,monospace}\n.term .tbar{display:flex;gap:6px;padding:8px 10px;background:#12161c;border-bottom:1px solid var(--line,#262C34)}\n.term .tbar i{width:9px;height:9px;border-radius:50%;background:#2f313c}\n.term .tbody{padding:10px 12px;color:#c9d2e0;min-height:78px;line-height:1.6}\n.term .tbody .p{color:var(--accent,#3366FF)}</style>\n<div class=\"term\"><div class=\"tbar\"><i></i><i></i><i></i></div><div class=\"tbody\" id=\"tb\"></div></div>\n<script>var lines=['$ goodwork build','tokens loaded','43 motions wired','site ready ->'],tb=document.getElementById('tb');\nfunction play(){tb.innerHTML='';var i=0;(function next(){if(i>=lines.length)return;var l=lines[i],d=document.createElement('div');if(l[0]==='$')d.innerHTML='<span class=\"p\">$</span>'+l.slice(1);else d.textContent='  '+l;tb.appendChild(d);i++;setTimeout(next,520);})();}\nplay();setInterval(play,3800);</script>"}