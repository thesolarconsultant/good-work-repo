{"id":"carousel","code":"<style>.car{position:relative;width:240px;overflow:hidden;border-radius:14px;border:1px solid var(--line,#262C34)}\n.car .track{display:flex;transition:transform .6s cubic-bezier(.22,1,.36,1)}\n.car .slide{min-width:240px;height:130px;display:grid;place-items:center;font:800 24px Inter,sans-serif;color:#fff}\n.car .dots{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);display:flex;gap:6px}\n.car .dots i{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.45);transition:.3s}\n.car .dots i.on{background:var(--accent,#3366FF);width:18px;border-radius:4px}</style>\n<div class=\"car\"><div class=\"track\" id=\"ctrack\">\n<div class=\"slide\" style=\"background:linear-gradient(135deg,#7A5CFF,#3366FF)\">Solar</div>\n<div class=\"slide\" style=\"background:linear-gradient(135deg,#6C2BD9,#3366FF)\">Battery</div>\n<div class=\"slide\" style=\"background:linear-gradient(135deg,#1a2233,#0b0e13)\">Heating</div></div>\n<div class=\"dots\" id=\"cdots\"></div></div>\n<script>var n=3,i=0,tr=document.getElementById('ctrack'),dt=document.getElementById('cdots');\nfor(var k=0;k<n;k++)dt.innerHTML+='<i></i>';var dots=dt.querySelectorAll('i');\nfunction go(){tr.style.transform='translateX(-'+(i*240)+'px)';dots.forEach(function(d,x){d.classList.toggle('on',x===i);});}\ngo();setInterval(function(){i=(i+1)%n;go();},2200);</script>"}