{"id":"stagger","code":"<style>.sg{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;width:230px}\n.sg i{display:block;height:56px;border-radius:12px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);\n opacity:0;transform:translateY(18px) scale(.96);animation:sgin .6s cubic-bezier(.22,1,.36,1) forwards}\n@keyframes sgin{to{opacity:1;transform:none}}</style>\n<div class=\"sg\" id=\"sg\"></div>\n<script>var g=document.getElementById('sg');\nfunction play(){g.innerHTML='';for(var i=0;i<6;i++){var c=document.createElement('i');c.style.animationDelay=(i*0.09)+'s';g.appendChild(c);}}\nplay();setInterval(play,3000);</script>"}