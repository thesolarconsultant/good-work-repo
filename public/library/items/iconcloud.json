{"id":"iconcloud","code":"<style>.icl{position:relative;width:200px;height:150px}\n.icl span{position:absolute;font:700 13px Inter,sans-serif;color:var(--accent,#3366FF);white-space:nowrap;animation:iclf 5s ease-in-out infinite}\n.icl span:nth-child(odd){color:var(--ink,#fff)}</style>\n<div class=\"icl\" id=\"icl\"></div>\n<script>var tags=[['Solar',20,30],['Battery',110,20],['Heat',60,70],['EV',150,80],['Grid',20,100],['Inverter',95,120],['kWh',160,130]];\nvar el=document.getElementById('icl');el.innerHTML=tags.map(function(t,i){return '<span style=\"left:'+t[1]+'px;top:'+t[2]+'px;animation-delay:'+(i*0.4)+'s;font-size:'+(11+(i%3)*4)+'px\">'+t[0]+'</span>';}).join('');</script>\n<style>@keyframes iclf{0%,100%{transform:translateY(0);opacity:.7}50%{transform:translateY(-8px);opacity:1}}</style>"}