{"id":"heroquote","code":"<style>.hqt{width:340px;font-family:Inter,system-ui,sans-serif;padding:16px 14px;display:flex;flex-direction:column;gap:12px}\n.hqt .pill{align-self:flex-start;display:inline-flex;align-items:center;gap:8px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:99px;padding:4px 12px 4px 4px;color:var(--body,#B6BDC8);font:500 10px Inter,sans-serif}\n.hqt .pill b{background:var(--accent,#3366FF);color:#fff;font:600 9px Inter,sans-serif;padding:2px 8px;border-radius:99px}\n.hqt h1{margin:0;color:var(--ink,#fff);font:600 20px Inter,sans-serif;line-height:1.2;letter-spacing:-.02em}\n.hqt .cta{display:flex;gap:10px}\n.hqt .cta a{font:700 12px Inter,sans-serif;padding:9px 18px;border-radius:99px;text-decoration:none}\n.hqt .cta .p{background:var(--accent,#3366FF);color:#fff}.hqt .cta .s{background:var(--card,#171B22);border:1px solid var(--line,#262C34);color:var(--ink,#fff)}\n.hqt .q{display:flex;gap:10px;align-items:flex-start;margin-top:4px}\n.hqt .q .av{width:36px;height:36px;border-radius:50%;flex:none;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF))}\n.hqt .q p{margin:0;color:var(--ink,#fff);font:500 12px Inter,sans-serif}\n.hqt .q span{color:var(--body,#B6BDC8);font:400 10px Inter,sans-serif}</style>\n<div class=\"hqt\"><span class=\"pill\"><b>Update</b> Browse new layouts →</span><h1>A component library built to help teams design better web experiences.</h1><div class=\"cta\"><a class=\"p\">Get started</a><a class=\"s\">Contact us</a></div><div class=\"q\"><span class=\"av\"></span><div><p>&ldquo;Sleek design, exceeds expectations, highly recommended!&rdquo;</p><span>Emily Jones, Design Head @ Glyph</span></div></div></div>"}