{"id":"morphing","code":"<style>.mph{position:relative;font:900 34px Inter,sans-serif;color:var(--accent,#3366FF);height:46px;min-width:170px}\n.mph span{position:absolute;left:50%;top:0;transform:translateX(-50%);white-space:nowrap;transition:opacity .6s,filter .6s;filter:blur(0)}\n.mph .off{opacity:0;filter:blur(8px)}</style>\n<div class=\"mph\"><span id=\"mpa\">Solar</span><span class=\"off\" id=\"mpb\">Storage</span></div>\n<script>var words=['Solar','Storage','Heating','Savings'],i=0,cur=document.getElementById('mpa'),nxt=document.getElementById('mpb');\nsetInterval(function(){i=(i+1)%words.length;nxt.textContent=words[i];nxt.classList.remove('off');cur.classList.add('off');var t=cur;cur=nxt;nxt=t;},1800);</script>"}