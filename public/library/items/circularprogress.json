{"id":"circularprogress","code":"<style>.cp{position:relative;width:96px;height:96px}.cp svg{transform:rotate(-90deg)}\n.cp .bg{fill:none;stroke:var(--line,#262C34);stroke-width:8}\n.cp .fg{fill:none;stroke:var(--accent,#3366FF);stroke-width:8;stroke-linecap:round;stroke-dasharray:264;stroke-dashoffset:264;transition:stroke-dashoffset 1.4s cubic-bezier(.22,1,.36,1)}\n.cp b{position:absolute;inset:0;display:grid;place-items:center;font:800 22px Inter,sans-serif;color:var(--ink,#fff)}</style>\n<div class=\"cp\"><svg width=\"96\" height=\"96\" viewBox=\"0 0 96 96\"><circle class=\"bg\" cx=\"48\" cy=\"48\" r=\"42\"/><circle class=\"fg\" id=\"cpf\" cx=\"48\" cy=\"48\" r=\"42\"/></svg><b id=\"cpv\">0%</b></div>\n<script>var f=document.getElementById('cpf'),v=document.getElementById('cpv');\nfunction p(){f.style.transition='none';f.style.strokeDashoffset=264;v.textContent='0%';requestAnimationFrame(function(){f.style.transition='';f.style.strokeDashoffset=264*0.28;var s=Date.now();var iv=setInterval(function(){var t=Math.min(1,(Date.now()-s)/1400);v.textContent=Math.round((1-Math.pow(1-t,3))*72)+'%';if(t>=1)clearInterval(iv);},30);});}\np();setInterval(p,3000);</script>"}