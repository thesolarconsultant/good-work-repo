{"id":"faqsection","code":"<style>.fqs{width:290px;font-family:Inter,system-ui,sans-serif;text-align:center}\n.fqs .eb{color:var(--accent,#3366FF);font:700 10px 'JetBrains Mono',monospace;letter-spacing:.12em;margin-bottom:4px}\n.fqs h4{color:var(--ink,#fff);font:800 20px Inter,sans-serif;margin:0 0 12px}\n.fqs .acc{text-align:left}.fqs .item{border-bottom:1px solid var(--line,#262C34)}\n.fqs .q{width:100%;text-align:left;background:none;border:0;color:var(--ink,#fff);font:700 12.5px Inter,sans-serif;padding:11px 0;cursor:pointer;display:flex;justify-content:space-between;gap:8px}\n.fqs .ch{width:14px;height:14px;flex:none;position:relative}.fqs .ch::before,.fqs .ch::after{content:\"\";position:absolute;top:50%;left:50%;width:10px;height:2px;background:var(--accent,#3366FF);transform:translate(-50%,-50%);border-radius:2px}\n.fqs .ch::after{transform:translate(-50%,-50%) rotate(90deg);transition:.3s cubic-bezier(.22,1,.36,1)}.fqs .item.open .ch::after{transform:translate(-50%,-50%) rotate(0)}\n.fqs .a{max-height:0;overflow:hidden;transition:max-height .35s cubic-bezier(.22,1,.36,1)}.fqs .a p{margin:0 0 11px;font-size:11px;color:var(--body,#B6BDC8);line-height:1.5}\n.fqs .more{margin-top:12px;font-size:10px;color:var(--body,#B6BDC8)}.fqs .more a{color:var(--accent,#3366FF)}</style>\n<div class=\"fqs\"><div class=\"eb\">FAQ</div><h4>Frequently asked questions</h4>\n<div class=\"acc\" id=\"fqacc\">\n<div class=\"item\"><button class=\"q\">Is there a free plan?<span class=\"ch\"></span></button><div class=\"a\"><p>Yes — a free tier with the essentials, no card needed.</p></div></div>\n<div class=\"item\"><button class=\"q\">Can I change my plan?<span class=\"ch\"></span></button><div class=\"a\"><p>Anytime, in settings. Changes apply from your next billing date.</p></div></div>\n<div class=\"item\"><button class=\"q\">How do I cancel?<span class=\"ch\"></span></button><div class=\"a\"><p>One click in account settings — access lasts until the period ends.</p></div></div></div>\n<div class=\"more\">Still have questions? <a href=\"#\">Email us</a></div></div>\n<script>var acc=document.getElementById('fqacc'),items=acc.querySelectorAll('.item');\nfunction openItem(it){items.forEach(function(i){i.classList.remove('open');i.querySelector('.a').style.maxHeight='0';});if(it){it.classList.add('open');var a=it.querySelector('.a');a.style.maxHeight=a.scrollHeight+'px';}}\nacc.querySelectorAll('.q').forEach(function(q){q.addEventListener('click',function(){var it=q.parentNode;openItem(it.classList.contains('open')?null:it);});});\nvar idx=0;function demo(){openItem(items[idx%items.length]);idx++;}demo();setInterval(demo,2200);</script>"}