{"id":"infinitespiral","code":"<style>.isp{width:250px;height:230px;position:relative;perspective:800px;overflow:hidden;font-family:Inter,system-ui,sans-serif;-webkit-mask:linear-gradient(transparent,#000 24%,#000 76%,transparent);mask:linear-gradient(transparent,#000 24%,#000 76%,transparent)}\n.isp .drum{position:absolute;left:50%;top:50%;width:0;height:0;transform-style:preserve-3d;animation:ispspin 14s linear infinite}\n.isp:hover .drum{animation-play-state:paused}\n.isp .card{position:absolute;width:96px;height:96px;margin:-48px 0 0 -48px;border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.12);backface-visibility:hidden;filter:grayscale(1) contrast(1.05)}\n.isp .g0{background:linear-gradient(135deg,#7A5CFF,#C0392B)}.isp .g1{background:linear-gradient(135deg,#5B5BFF,#1E9E6A)}.isp .g2{background:linear-gradient(135deg,#F5A623,#3366FF)}.isp .g3{background:linear-gradient(135deg,#7C4DFF,#FF2E88)}.isp .g4{background:linear-gradient(135deg,#1E9E6A,#5B5BFF)}.isp .g5{background:linear-gradient(135deg,#3366FF,#7C4DFF)}.isp .g6{background:linear-gradient(135deg,#C0392B,#F5A623)}\n@keyframes ispspin{to{transform:rotateY(360deg)}}\n@media(prefers-reduced-motion:reduce){.isp .drum{animation:none}}</style>\n<div class=\"isp\"><div class=\"drum\" id=\"isd\"></div></div>\n<script>(function(){var drum=document.currentScript.parentNode.querySelector('#isd');var N=7,R=150,VS=26;for(var i=0;i<N;i++){var d=document.createElement('div');d.className='card g'+i;var ang=i*(360/N);d.style.transform='rotateY('+ang+'deg) translateZ('+R+'px) translateY('+((i-(N-1)/2)*VS)+'px)';drum.appendChild(d);}})();</script>"}