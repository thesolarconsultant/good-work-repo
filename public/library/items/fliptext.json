{"id":"fliptext","code":"<style>.flp{font:900 34px Inter,sans-serif;color:var(--ink,#fff);perspective:500px}\n.flp span{display:inline-block;animation:flip .6s cubic-bezier(.22,1,.36,1) both}\n@keyframes flip{from{transform:rotateX(-90deg);opacity:0}to{transform:none;opacity:1}}</style>\n<div class=\"flp\" id=\"flp\"></div>\n<script>var t=\"GOOD WORK.\",el=document.getElementById('flp');\nfunction play(){el.innerHTML=t.split('').map(function(c,i){return '<span style=\"animation-delay:'+(i*0.08)+'s\">'+c+'</span>';}).join('');}\nplay();setInterval(play,2600);</script>"}