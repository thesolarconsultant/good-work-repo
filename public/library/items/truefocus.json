{"id":"truefocus","code":"<style>.trf{font:800 24px Inter,sans-serif;color:var(--ink,#fff);display:flex;gap:12px}\n.trf span{filter:blur(4px);opacity:.5;transition:.4s;position:relative}\n.trf span.on{filter:none;opacity:1;color:var(--accent,#3366FF)}</style>\n<div class=\"trf\" id=\"trf\"></div>\n<script>var w=['Solar','storage','saved'],el=document.getElementById('trf');el.innerHTML=w.map(function(x){return '<span>'+x+'</span>';}).join('');\nvar s=el.querySelectorAll('span'),i=0;function go(){s.forEach(function(x){x.classList.remove('on');});s[i].classList.add('on');i=(i+1)%s.length;}go();setInterval(go,1400);</script>"}