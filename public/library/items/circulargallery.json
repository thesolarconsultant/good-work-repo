{"id":"circulargallery","code":"<style>.cgl{width:330px;height:200px;position:relative;perspective:900px;overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:grab;user-select:none;touch-action:pan-y}\n.cgl.drag{cursor:grabbing}\n.cgl .stage{position:absolute;inset:0;transform-style:preserve-3d}\n.cgl .card{position:absolute;left:50%;top:50%;width:120px;height:150px;margin:-80px 0 0 -60px;border-radius:12px;overflow:hidden;border:1px solid var(--line,#262C34);transition:transform .45s cubic-bezier(.22,1,.36,1),opacity .45s;box-shadow:0 20px 40px -20px rgba(0,0,0,.6)}\n.cgl .card .img{height:120px}\n.cgl .card .cap{height:30px;display:flex;align-items:center;justify-content:center;background:var(--card,#171B22);color:var(--ink,#fff);font:700 11px Inter,sans-serif}\n.cgl .g0 .img{background:linear-gradient(135deg,#7A5CFF,#C0392B)}.cgl .g1 .img{background:linear-gradient(135deg,#5B5BFF,#1E9E6A)}.cgl .g2 .img{background:linear-gradient(135deg,#F5A623,#3366FF)}.cgl .g3 .img{background:linear-gradient(135deg,#7C4DFF,#FF2E88)}.cgl .g4 .img{background:linear-gradient(135deg,#1E9E6A,#5B5BFF)}.cgl .g5 .img{background:linear-gradient(135deg,#3366FF,#7C4DFF)}</style>\n<div class=\"cgl\"><div class=\"stage\" id=\"cgs\"></div></div>\n<script>(function(){var root=document.currentScript.parentNode.querySelector('.cgl');var stage=root.querySelector('#cgs');var labels=['Mountain','Forest','Summit','Ocean','Meadow','Desert'];var cards=labels.map(function(t,i){var d=document.createElement('div');d.className='card g'+i;d.innerHTML='<div class=\"img\"></div><div class=\"cap\">'+t+'</div>';stage.appendChild(d);return d;});var c=0,N=labels.length,timer;function render(){cards.forEach(function(el,i){var o=i-c;if(o>N/2)o-=N;if(o<-N/2)o+=N;el.style.transform='translateX('+(o*72)+'px) translateZ('+(-Math.abs(o)*90)+'px) rotateY('+(-o*38)+'deg)';el.style.opacity=Math.max(0,1-Math.abs(o)*0.34);el.style.zIndex=String(20-Math.abs(o));});}function set(n){c=(n%N+N)%N;render();}cards.forEach(function(el,i){el.addEventListener('click',function(){set(i);reset();});});root.addEventListener('wheel',function(e){e.preventDefault();set(c+(e.deltaY>0?1:-1));reset();},{passive:false});var down=false,sx=0,sc=0;root.addEventListener('pointerdown',function(e){down=true;sx=e.clientX;sc=c;root.classList.add('drag');clearInterval(timer);});window.addEventListener('pointermove',function(e){if(!down)return;set(Math.round(sc-(e.clientX-sx)/80));});window.addEventListener('pointerup',function(){if(down){down=false;root.classList.remove('drag');reset();}});function reset(){clearInterval(timer);timer=setInterval(function(){set(c+1);},2600);}root.addEventListener('mouseenter',function(){clearInterval(timer);});root.addEventListener('mouseleave',reset);render();reset();})();</script>"}