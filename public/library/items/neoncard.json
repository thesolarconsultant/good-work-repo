{"id":"neoncard","code":"<style>.neon{position:relative;width:210px;height:118px;border-radius:18px;background:#0b0e13;display:grid;place-items:center;color:#fff;font:700 15px Inter,sans-serif}\n.neon::before{content:\"\";position:absolute;inset:-2px;border-radius:20px;z-index:-1;filter:blur(11px);\n background:linear-gradient(120deg,var(--accent,#3366FF),#7A5CFF,#FFD36A,var(--accent,#3366FF));background-size:300% 300%;animation:neon 4s linear infinite}\n@keyframes neon{to{background-position:300% 0}}</style>\n<div class=\"neon\">Neon Card</div>"}