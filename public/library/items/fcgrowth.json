{"id":"fcgrowth","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:200px;display:grid;place-items:center;padding:20px}\n.fc .chart{position:relative;width:100%;height:130px;border:1px solid var(--line,#262C34);border-radius:12px;overflow:hidden;background:var(--card2,#20252E)}\n.fc .chart b{position:absolute;top:12px;left:14px;color:var(--ink,#fff);font:700 15px Inter,sans-serif;z-index:2}\n.fc .chart svg{position:absolute;inset:0;width:100%;height:100%;filter:saturate(.3);opacity:.55;transform:scale(1) translateY(20%);transform-origin:bottom;transition:.4s cubic-bezier(.22,1,.36,1)}\n.fc:hover .chart svg{filter:saturate(1);opacity:1;transform:scale(1) translateY(0)}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}</style>\n<div class=\"fc\"><div class=\"stage\"><div class=\"chart\"><b>+245%</b><svg viewBox=\"0 0 300 130\" preserveAspectRatio=\"none\"><defs><linearGradient id=\"fcg\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"var(--accent,#3366FF)\"/><stop offset=\"1\" stop-color=\"var(--accent,#3366FF)\" stop-opacity=\"0\"/></linearGradient></defs><path d=\"M0 120 C60 120 130 40 300 8 L300 130 L0 130 Z\" fill=\"url(#fcg)\"/><path d=\"M0 120 C60 120 130 40 300 8\" fill=\"none\" stroke=\"var(--accent,#3366FF)\" stroke-width=\"2.5\"/></svg></div></div><div class=\"foot\"><h2>Growth</h2><p>Invest and watch your money grow</p></div></div>"}