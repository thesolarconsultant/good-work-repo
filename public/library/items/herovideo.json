{"id":"herovideo","code":"<style>.hvd{position:relative;width:250px;height:140px;border-radius:14px;overflow:hidden;cursor:pointer;\n background:linear-gradient(135deg,#1a2233,#0b0e13)}\n.hvd .play{position:absolute;inset:0;display:grid;place-items:center}\n.hvd .play b{width:56px;height:56px;border-radius:50%;background:var(--accent,#3366FF);display:grid;place-items:center;box-shadow:0 0 0 0 rgba(51,102,255,.5);animation:hvp 2s ease-out infinite}\n.hvd .play b::after{content:\"\";border-left:16px solid #fff;border-top:10px solid transparent;border-bottom:10px solid transparent;margin-left:4px}\n@keyframes hvp{0%{box-shadow:0 0 0 0 rgba(51,102,255,.5)}100%{box-shadow:0 0 0 20px rgba(51,102,255,0)}}\n.hvd .dlg{position:absolute;inset:0;background:rgba(0,0,0,.7);display:none;place-items:center;color:#fff;font:700 14px Inter,sans-serif}\n.hvd.open .dlg{display:grid}.hvd.open .play{display:none}</style>\n<div class=\"hvd\" id=\"hvd\"><div class=\"play\"><b></b></div><div class=\"dlg\">▶ playing…</div></div>\n<script>var h=document.getElementById('hvd');h.addEventListener('click',function(){h.classList.toggle('open');});</script>"}