{"id":"wink","code":"<style>.sun{position:relative;width:96px;height:96px}\n.sun .disc{position:absolute;inset:20px;border-radius:50%;background:var(--accent,#3366FF)}\n.sun .ray{position:absolute;left:50%;top:50%;width:5px;height:13px;margin:-6px 0 0 -2px;border-radius:3px;background:var(--accent,#3366FF)}\n.sun .face{position:absolute;inset:30px;display:flex;justify-content:center;align-items:center;gap:12px}\n.sun .eye{width:9px;height:9px;border-radius:50%;background:#0B0E13}\n.sun .eye.r{animation:wink 3.4s ease-in-out infinite;transform-origin:center}\n@keyframes wink{0%,84%,100%{transform:scaleY(1)}90%{transform:scaleY(.1)}}</style>\n<div class=\"sun\" id=\"sun\"><div class=\"disc\"></div><div class=\"face\"><div class=\"eye l\"></div><div class=\"eye r\"></div></div></div>\n<script>var s=document.getElementById('sun');for(var i=0;i<12;i++){var r=document.createElement('div');r.className='ray';r.style.transform='rotate('+(i*30)+'deg) translateY(-40px)';s.appendChild(r);}</script>"}