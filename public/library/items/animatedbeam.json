{"id":"animatedbeam","code":"<style>.abeam{position:relative;width:260px;height:110px}\n.abeam .node{position:absolute;top:50%;width:44px;height:44px;margin-top:-22px;border-radius:12px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);display:grid;place-items:center}\n.abeam .node::after{content:\"\";width:14px;height:14px;border-radius:50%;background:var(--accent,#3366FF);box-shadow:0 0 14px var(--accent,#3366FF)}\n.abeam .n1{left:0}.abeam .n2{right:0}\n.abeam svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}\n.abeam path{fill:none;stroke-linecap:round}.abeam .base{stroke:var(--line,#262C34);stroke-width:2}\n.abeam .flow{stroke:var(--accent,#3366FF);stroke-width:3;stroke-dasharray:46 220;animation:abf 1.8s cubic-bezier(.45,0,.55,1) infinite}\n@keyframes abf{from{stroke-dashoffset:46}to{stroke-dashoffset:-220}}</style>\n<div class=\"abeam\"><svg viewBox=\"0 0 260 110\"><path class=\"base\" d=\"M44 55 C110 12,150 98,216 55\"/><path class=\"flow\" d=\"M44 55 C110 12,150 98,216 55\"/></svg><div class=\"node n1\"></div><div class=\"node n2\"></div></div>"}