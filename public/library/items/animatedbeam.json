{"id":"animatedbeam","code":"<style>.abeam{position:relative;width:230px;height:96px}\n.abeam .node{position:absolute;top:50%;width:34px;height:34px;margin-top:-17px;border-radius:10px;background:var(--card,#171B22);border:1px solid var(--line,#262C34)}\n.abeam .n1{left:0}.abeam .n2{right:0}\n.abeam svg{position:absolute;inset:0;width:100%;height:100%}\n.abeam path{fill:none}.abeam .base{stroke:var(--line,#262C34);stroke-width:2}\n.abeam .flow{stroke:var(--accent,#3366FF);stroke-width:2.5;stroke-dasharray:14 130;animation:abf 1.6s linear infinite}\n@keyframes abf{to{stroke-dashoffset:-144}}</style>\n<div class=\"abeam\"><svg viewBox=\"0 0 230 96\"><path class=\"base\" d=\"M28 48 C90 48,140 48,202 48\"/><path class=\"flow\" d=\"M28 48 C90 48,140 48,202 48\"/></svg><div class=\"node n1\"></div><div class=\"node n2\"></div></div>"}