{"id":"fcnotify","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:200px;display:grid;place-items:center;position:relative}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}\n.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}\n.fc .row{position:absolute;width:180px;display:flex;align-items:center;gap:10px;background:var(--card2,#20252E);border:1px solid var(--line,#262C34);border-radius:8px;padding:10px;transition:.25s cubic-bezier(.22,1,.36,1)}\n.fc .row .av{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF));flex:none}\n.fc .row .ln{display:flex;flex-direction:column;gap:5px;flex:1}.fc .row .ln i{height:6px;border-radius:99px;background:#3A424E;display:block}\n.fc .row .ln i:nth-child(1){width:70%}.fc .row .ln i:nth-child(2){width:100%}\n.fc .r1{transform:translateY(-6px) scale(.9)}.fc .r2{transform:translateY(-6px) scale(.95)}.fc .r3{transform:translateY(-6px);opacity:0}\n.fc:hover .r1{transform:translateY(-58px) scale(.86)}\n.fc:hover .r2{transform:translateY(-24px) scale(.93);box-shadow:0 20px 50px -18px rgba(51,102,255,.5)}\n.fc:hover .r3{transform:translateY(30px);opacity:1;box-shadow:0 20px 50px -20px rgba(51,102,255,.35)}</style>\n<div class=\"fc\"><div class=\"stage\"><div class=\"row r1\"><span class=\"av\"></span><span class=\"ln\"><i></i><i></i></span></div><div class=\"row r2\"><span class=\"av\"></span><span class=\"ln\"><i></i><i></i></span></div><div class=\"row r3\"><span class=\"av\"></span><span class=\"ln\"><i></i><i></i></span></div></div><div class=\"foot\"><h2>Notifications</h2><p>Instantly get notified about events</p></div></div>"}