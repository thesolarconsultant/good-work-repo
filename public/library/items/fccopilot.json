{"id":"fccopilot","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px}\n.fc .pop{border:1px solid var(--line,#262C34);border-radius:99px;padding:3px 12px;color:var(--ink,#fff);font:500 12px Inter,sans-serif;transform:translateY(6px) scale(.5);opacity:0;transition:.3s cubic-bezier(.22,1,.36,1)}\n.fc:hover .pop{transform:translateY(-2px) scale(1);opacity:1}\n.fc .cmt{display:flex;gap:10px;max-width:220px;border:1px solid var(--line,#262C34);border-radius:10px;padding:12px;background:var(--card2,#20252E);transition:.3s cubic-bezier(.22,1,.36,1)}\n.fc:hover .cmt{transform:translateY(8px) scale(1.04);box-shadow:0 24px 60px -22px rgba(51,102,255,.5)}\n.fc .cmt .av{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF));flex:none}\n.fc .cmt h3{margin:0;color:var(--ink,#fff);font:600 13px Inter,sans-serif}.fc .cmt p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 11px Inter,sans-serif;line-height:1.4}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}</style>\n<div class=\"fc\"><div class=\"stage\"><span class=\"pop\">Make it Pop ✨</span><div class=\"cmt\"><span class=\"av\"></span><div><h3>Josh</h3><p>Lorem ipsum dolor sit amet, consectetur.</p></div></div></div><div class=\"foot\"><h2>AI Co-Pilot</h2><p>Use AI to make your writing stand out</p></div></div>"}