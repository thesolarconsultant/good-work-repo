{"id":"fclist","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:200px;overflow:hidden;position:relative}\n.fc .strip{display:flex;flex-direction:column;gap:12px;padding:16px;transition:transform .35s cubic-bezier(.22,1,.36,1)}\n.fc:hover .strip{transform:translateY(-96px)}\n.fc .item{border:1px solid var(--line,#262C34);border-radius:8px;padding:10px 12px;background:var(--card2,#20252E)}\n.fc .item h4{margin:0;color:var(--ink,#fff);font:600 12px Inter,sans-serif;display:flex;align-items:center;gap:7px}\n.fc .item h4 b{color:var(--accent,#3366FF)}.fc .item p{margin:4px 0 0;color:var(--body,#B6BDC8);font:400 10px Inter,sans-serif}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}</style>\n<div class=\"fc\"><div class=\"stage\"><div class=\"strip\"><div class=\"item\"><h4><b>★</b> New Feature Release</h4><p>Experience the latest features now.</p></div><div class=\"item\"><h4><b>↓</b> App Update Available</h4><p>Get the latest version.</p></div><div class=\"item\"><h4><b>◷</b> Scheduled Maintenance</h4><p>Temporarily unavailable soon.</p></div><div class=\"item\"><h4><b>✎</b> Feedback Appreciated</h4><p>Share your thoughts with us.</p></div></div></div><div class=\"foot\"><h2>Notifications</h2><p>Instantly get notified about events</p></div></div>"}