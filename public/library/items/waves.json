{"id":"waves","code":"<style>.wav{position:relative;width:240px;height:130px;border-radius:14px;overflow:hidden;background:#0b0e13;border:1px solid var(--line,#262C34)}\n.wav svg{position:absolute;bottom:0;left:0;width:200%;height:100%}\n.wav path{fill:none;stroke:var(--accent,#3366FF);stroke-width:2}\n.wav .w1{animation:wavm 4s linear infinite;opacity:.6}.wav .w2{animation:wavm 6s linear infinite;opacity:.3}\n@keyframes wavm{to{transform:translateX(-50%)}}</style>\n<div class=\"wav\"><svg viewBox=\"0 0 480 130\" preserveAspectRatio=\"none\"><path class=\"w1\" d=\"M0 80 Q60 50 120 80 T240 80 T360 80 T480 80\"/><path class=\"w2\" d=\"M0 96 Q60 66 120 96 T240 96 T360 96 T480 96\"/></svg></div>"}