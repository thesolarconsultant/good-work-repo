{"id":"backlight","code":"<style>.bkl{position:relative;width:200px;height:110px;border-radius:16px;background:var(--card,#171B22);border:1px solid var(--line,#262C34);\n display:grid;place-items:center;color:var(--ink,#fff);font:700 15px Inter,sans-serif}\n.bkl::before{content:\"\";position:absolute;inset:10px;border-radius:16px;z-index:-1;filter:blur(22px);\n background:var(--accent,#3366FF);animation:bklm 2.6s ease-in-out infinite}\n@keyframes bklm{0%,100%{opacity:.5}50%{opacity:.95}}</style>\n<div class=\"bkl\">Backlight</div>"}