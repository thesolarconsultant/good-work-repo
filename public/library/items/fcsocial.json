{"id":"fcsocial","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:200px;display:flex;align-items:center;justify-content:center;gap:14px}\n.fc .card3{width:70px;display:flex;flex-direction:column;align-items:center;gap:8px;border:1px solid var(--line,#262C34);border-radius:8px;padding:12px 8px;background:var(--card2,#20252E);transition:.25s cubic-bezier(.22,1,.36,1)}\n.fc .card3 .av{width:26px;height:26px;border-radius:50%;background:linear-gradient(135deg,var(--accent-2,#7A5CFF),var(--accent,#3366FF))}\n.fc .card3 .g{display:grid;grid-template-columns:1fr 1fr;gap:5px}.fc .card3 .g i{width:22px;height:6px;border-radius:99px;background:#3A424E;display:block}\n.fc .c1{transform:translateX(38px) rotate(-4deg) scale(.8);z-index:1}.fc .c2{transform:scale(1.1);z-index:2}.fc .c3{transform:translateX(-38px) rotate(4deg) scale(.8);z-index:1}\n.fc:hover .c1{transform:none;box-shadow:0 18px 50px -18px rgba(51,102,255,.4)}\n.fc:hover .c2{transform:scale(1);box-shadow:0 18px 50px -18px rgba(122,92,255,.4)}\n.fc:hover .c3{transform:none;box-shadow:0 18px 50px -18px rgba(51,102,255,.4)}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}</style>\n<div class=\"fc\"><div class=\"stage\"><div class=\"card3 c1\"><span class=\"av\"></span><span class=\"g\"><i></i><i></i><i></i><i></i></span></div><div class=\"card3 c2\"><span class=\"av\"></span><span class=\"g\"><i></i><i></i><i></i><i></i></span></div><div class=\"card3 c3\"><span class=\"av\"></span><span class=\"g\"><i></i><i></i><i></i><i></i></span></div></div><div class=\"foot\"><h2>Social</h2><p>Write once, share with your friends</p></div></div>"}