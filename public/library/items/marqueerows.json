{"id":"marqueerows","code":"<style>.mq2{display:flex;flex-direction:column;gap:10px;width:280px}\n.mq2 .row{overflow:hidden;-webkit-mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent);mask:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent)}\n.mq2 ul{display:flex;gap:12px;list-style:none;padding:0;margin:0;width:max-content;animation:mq2m 12s linear infinite}\n.mq2 .row.b ul{animation-direction:reverse}\n.mq2 li{font:700 13px Inter,sans-serif;color:var(--ink,#fff);background:var(--card,#171B22);border:1px solid var(--line,#262C34);border-radius:8px;padding:6px 12px;white-space:nowrap}\n@keyframes mq2m{to{transform:translateX(-50%)}}</style>\n<div class=\"mq2\"><div class=\"row\"><ul id=\"r1\"></ul></div><div class=\"row b\"><ul id=\"r2\"></ul></div></div>\n<script>var a=['Enphase','JA Solar','LONGi','Huawei'],b=['GoodWe','Tesla','SolarEdge','Fronius'];\ndocument.getElementById('r1').innerHTML=a.concat(a).map(function(x){return '<li>'+x+'</li>';}).join('');\ndocument.getElementById('r2').innerHTML=b.concat(b).map(function(x){return '<li>'+x+'</li>';}).join('');</script>"}