{"id":"codecompare","code":"<style>.cc{width:250px;border-radius:12px;overflow:hidden;border:1px solid var(--line,#262C34);font:500 12px 'JetBrains Mono',ui-monospace,monospace}\n.cc .hd{padding:8px 12px;background:#12161c;color:#8A93A2;border-bottom:1px solid var(--line,#262C34)}\n.cc .ln{padding:3px 12px;color:#c9d2e0}\n.cc .del{background:rgba(255,60,60,.12);color:#ff9a9a}.cc .add{background:rgba(51,102,255,.14);color:var(--accent,#3366FF)}</style>\n<div class=\"cc\"><div class=\"hd\">brand.css</div>\n<div class=\"ln del\">- --accent: #4C5BD4;</div><div class=\"ln add\">+ --accent: #3366FF;</div><div class=\"ln\">&nbsp;&nbsp;--radius: 16px;</div></div>"}