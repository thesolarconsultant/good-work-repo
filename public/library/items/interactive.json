{"id":"interactive","code":"<style>.ih{position:relative;border:1px solid var(--line,#262C34);background:var(--card,#171B22);color:var(--ink,#fff);cursor:pointer;\n font:700 15px Inter,sans-serif;padding:14px 26px 14px 44px;border-radius:999px;overflow:hidden;transition:.3s}\n.ih .dot{position:absolute;left:16px;top:50%;width:10px;height:10px;margin-top:-5px;border-radius:50%;background:var(--accent,#3366FF);transition:.35s;z-index:0}\n.ih span.t{position:relative;z-index:1}\n.ih:hover{color:#fff;padding-left:26px;border-color:var(--accent,#3366FF)}\n.ih:hover .dot{width:260%;height:340%;left:-30%;top:-120%;margin:0;border-radius:0}</style>\n<button class=\"ih\"><span class=\"dot\"></span><span class=\"t\">Get a quote &rarr;</span></button>"}