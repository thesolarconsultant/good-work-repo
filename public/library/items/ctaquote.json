{"id":"ctaquote","code":"<style>.ctq{width:280px;border:1px solid var(--line,#262C34);border-radius:16px;overflow:hidden;font-family:Inter,system-ui,sans-serif;background:var(--card,#171B22)}\n.ctq .img{height:64px;background:linear-gradient(135deg,#7A5CFF,var(--accent,#3366FF))}\n.ctq .body{padding:16px}.ctq blockquote{margin:0;color:var(--ink,#fff);font:700 14px Inter,sans-serif;line-height:1.4}\n.ctq blockquote mark{background:var(--accent,#3366FF);color:#fff;padding:0 4px;border-radius:3px}\n.ctq .by{margin:10px 0 12px}.ctq .by b{color:var(--ink,#fff);font-size:12px}.ctq .by span{display:block;color:var(--body,#B6BDC8);font-size:10px}\n.ctq a{display:block;text-align:center;background:var(--accent,#3366FF);color:#fff;font:700 12px Inter,sans-serif;padding:10px;border-radius:10px;text-decoration:none}</style>\n<div class=\"ctq\"><div class=\"img\"></div><div class=\"body\"><blockquote>&ldquo;The best <mark>animated component library</mark> I&rsquo;ve seen — it boosted our output overnight.&rdquo;</blockquote><div class=\"by\"><b>Jane Smith</b><span>CEO, Acme</span></div><a>Buy now</a></div></div>"}