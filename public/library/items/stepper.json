{"id":"stepper","code":"<style>.stp{display:flex;align-items:center}\n.stp .s{width:28px;height:28px;border-radius:50%;border:2px solid var(--line,#262C34);display:grid;place-items:center;font:700 12px Inter,sans-serif;color:#8A93A2;transition:.4s;flex:none}\n.stp .s.done{background:var(--accent,#3366FF);border-color:var(--accent,#3366FF);color:#fff}\n.stp .bar{width:34px;height:2px;background:var(--line,#262C34);transition:.4s}.stp .bar.done{background:var(--accent,#3366FF)}</style>\n<div class=\"stp\" id=\"stp\"></div>\n<script>var stp=document.getElementById('stp'),N=4;\nfunction draw(k){var h='';for(var i=0;i<N;i++){h+='<div class=\"s'+(i<=k?' done':'')+'\">'+(i+1)+'</div>';if(i<N-1)h+='<div class=\"bar'+(i<k?' done':'')+'\"></div>';}stp.innerHTML=h;}\nvar k=0;draw(0);setInterval(function(){k=(k+1)%(N+1);draw(k);},900);</script>"}