{"id":"fcstream","code":"<style>.fc{width:300px;border-radius:12px;border:1px solid var(--line,#262C34);background:var(--card,#171B22);overflow:hidden;font-family:Inter,system-ui,sans-serif;cursor:pointer}\n.fc .stage{height:220px;overflow:hidden;position:relative;-webkit-mask:linear-gradient(#000 60%,transparent);mask:linear-gradient(#000 60%,transparent)}\n.fc .feed{display:flex;flex-direction:column;gap:10px;padding:14px;animation:fcfeed 8s linear infinite}\n@keyframes fcfeed{0%,18%{transform:translateY(0)}23%,41%{transform:translateY(-62px)}46%,64%{transform:translateY(-124px)}69%,100%{transform:translateY(-186px)}}\n@media(prefers-reduced-motion:reduce){.fc .feed{animation:none}}\n.fc .n{display:flex;gap:11px;align-items:center;border:1px solid var(--line,#262C34);border-radius:10px;padding:11px;background:var(--card2,#20252E)}\n.fc .n .ic{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:15px;flex:none}\n.fc .n b{color:var(--ink,#fff);font:600 12px Inter,sans-serif}.fc .n b span{color:var(--body,#B6BDC8);font-weight:400;margin-left:6px;font-size:10px}\n.fc .n p{margin:2px 0 0;color:var(--body,#B6BDC8);font:400 10px Inter,sans-serif}\n.fc .foot{border-top:1px solid var(--line,#262C34);padding:14px}.fc .foot h2{margin:0;color:var(--ink,#fff);font:700 16px Inter,sans-serif}.fc .foot p{margin:3px 0 0;color:var(--body,#B6BDC8);font:400 12px Inter,sans-serif}</style>\n<div class=\"fc\"><div class=\"stage\"><div class=\"feed\"><div class=\"n\"><span class=\"ic\" style=\"background:var(--accent,#3366FF)\">💸</span><div><b>Payment received<span>15m ago</span></b><p>GOOD WORK.</p></div></div><div class=\"n\"><span class=\"ic\" style=\"background:#FFB800\">👤</span><div><b>User signed up<span>10m ago</span></b><p>GOOD WORK.</p></div></div><div class=\"n\"><span class=\"ic\" style=\"background:#FF3D71\">💬</span><div><b>New message<span>5m ago</span></b><p>GOOD WORK.</p></div></div><div class=\"n\"><span class=\"ic\" style=\"background:#1E86FF\">🗞️</span><div><b>New event<span>2m ago</span></b><p>GOOD WORK.</p></div></div></div></div><div class=\"foot\"><h2>Notifications</h2><p>Realtime alerts for events you follow</p></div></div>"}