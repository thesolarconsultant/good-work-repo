{"id":"typing","code":"<style>.ty{font:700 24px 'JetBrains Mono',ui-monospace,monospace;color:var(--ink,#fff)}\n.ty .cur{display:inline-block;width:2px;height:1.05em;background:var(--accent,#3366FF);margin-left:2px;vertical-align:-3px;animation:tyc 1s step-end infinite}\n@keyframes tyc{50%{opacity:0}}</style>\n<div class=\"ty\"><span id=\"ty\"></span><span class=\"cur\"></span></div>\n<script>var full=\"Your home, working together.\",el=document.getElementById('ty');\nfunction type(){el.textContent='';var i=0;var iv=setInterval(function(){el.textContent=full.slice(0,++i);if(i>=full.length)clearInterval(iv);},55);}\ntype();setInterval(type,4200);</script>"}