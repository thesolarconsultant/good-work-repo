{"id":"footermin","code":"<style>.ftm{width:292px;padding:14px 0;border-top:1px solid var(--line,#262C34);display:flex;align-items:center;justify-content:space-between;font:600 11px Inter,system-ui,sans-serif;flex-wrap:wrap;gap:10px}\n.ftm .lg{display:flex;align-items:center;gap:6px;font-weight:800;color:var(--ink,#fff);font-size:13px}.ftm .lg i{width:16px;height:16px;border-radius:50%;background:var(--accent,#3366FF)}\n.ftm ul{display:flex;gap:12px;list-style:none;margin:0;padding:0}.ftm a{color:var(--body,#B6BDC8);text-decoration:none;transition:.2s}.ftm a:hover{color:var(--accent,#3366FF)}\n.ftm .soc{display:flex;gap:8px}.ftm .soc i{width:16px;height:16px;border-radius:4px;background:var(--card,#171B22);border:1px solid var(--line,#262C34)}</style>\n<div class=\"ftm\"><span class=\"lg\"><i></i>GOOD WORK.</span><ul><li><a>About</a></li><li><a>Services</a></li><li><a>Contact</a></li></ul><span class=\"soc\"><i></i><i></i><i></i></span></div>"}