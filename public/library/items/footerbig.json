{"id":"footerbig","code":"<style>.ftb{width:292px;font:500 11px Inter,system-ui,sans-serif;color:var(--body,#B6BDC8);border-top:1px solid var(--line,#262C34)}\n.ftb .top{display:flex;gap:16px;padding:16px 0}\n.ftb .brand{flex:1.3}.ftb .brand .lg{display:flex;align-items:center;gap:6px;font-weight:800;color:var(--ink,#fff);font-size:13px}.ftb .brand .lg i{width:16px;height:16px;border-radius:4px;background:var(--accent,#3366FF)}\n.ftb .brand h4{color:var(--ink,#fff);font-size:13px;margin:9px 0 3px}.ftb .brand .cta{display:inline-block;margin-top:7px;background:var(--accent,#3366FF);color:#fff;font-weight:700;font-size:10px;padding:6px 12px;border-radius:999px}\n.ftb .cols{display:flex;gap:13px;flex:2}.ftb .col h5{color:var(--ink,#fff);font-size:9px;text-transform:uppercase;letter-spacing:.08em;margin:0 0 7px}.ftb .col a{display:block;color:var(--body,#B6BDC8);text-decoration:none;padding:2px 0;font-size:10px;transition:.2s}.ftb .col a:hover{color:var(--accent,#3366FF)}\n.ftb .bot{border-top:1px solid var(--line,#262C34);padding:9px 0;display:flex;justify-content:space-between;align-items:center;font-size:9px}\n.ftb .soc{display:flex;gap:6px}.ftb .soc i{width:14px;height:14px;border-radius:4px;background:var(--card,#171B22);border:1px solid var(--line,#262C34)}</style>\n<div class=\"ftb\"><div class=\"top\">\n<div class=\"brand\"><div class=\"lg\"><i></i>GOOD WORK.</div><h4>Get started today.</h4><div>Free quote. No obligation.</div><span class=\"cta\">Start free →</span></div>\n<div class=\"cols\"><div class=\"col\"><h5>Product</h5><a>Features</a><a>Pricing</a><a>FAQ</a></div><div class=\"col\"><h5>Company</h5><a>About</a><a>Blog</a><a>Careers</a></div><div class=\"col\"><h5>Legal</h5><a>Privacy</a><a>Terms</a></div></div></div>\n<div class=\"bot\"><div class=\"soc\"><i></i><i></i></div><span>© GOOD WORK.. All rights reserved.</span></div></div>"}