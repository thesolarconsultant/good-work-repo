{"id":"heroretro","code":"<style>.hrt{width:340px;position:relative;overflow:hidden;font-family:Inter,system-ui,sans-serif;padding:22px 14px 18px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:11px;border-radius:12px;background:#0B0E13}\n.hrt .grid{position:absolute;left:-25%;right:-25%;bottom:0;height:150px;overflow:hidden;opacity:.5;pointer-events:none;perspective:200px}\n.hrt .grid::before{content:\"\";position:absolute;inset:-50% 0 0;background-image:linear-gradient(var(--accent,#3366FF) 1px,transparent 1px),linear-gradient(90deg,var(--accent,#3366FF) 1px,transparent 1px);background-size:32px 32px;transform:rotateX(60deg);transform-origin:bottom;animation:hrtscroll 4s linear infinite}\n@keyframes hrtscroll{to{background-position:0 32px}}\n@media(prefers-reduced-motion:reduce){.hrt .grid::before{animation:none}}\n.hrt h1{position:relative;margin:0;font:800 24px Inter,sans-serif;line-height:1.1;background:linear-gradient(160deg,#fff 30%,#8A93A2);-webkit-background-clip:text;background-clip:text;color:transparent}\n.hrt p{position:relative;margin:0;color:var(--body,#B6BDC8);font:500 12px Inter,sans-serif;max-width:250px;line-height:1.5}\n.hrt a{position:relative;background:var(--accent,#3366FF);color:#fff;font:700 12px Inter,sans-serif;padding:9px 18px;border-radius:99px;text-decoration:none}\n.hrt .panel{position:relative;width:290px;height:90px;margin-top:4px;border-radius:12px;border:1px solid var(--line,#262C34);background:linear-gradient(#171B22,#0E1219);overflow:hidden}\n.hrt .panel .beam{position:absolute;inset:0;border-radius:12px;padding:1.5px;background:conic-gradient(from var(--ha,0deg),transparent 0 72%,var(--accent,#3366FF) 88%,transparent 100%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:hrtspin 5s linear infinite}\n@property --ha{syntax:'<angle>';inherits:false;initial-value:0deg}@keyframes hrtspin{to{--ha:360deg}}</style>\n<div class=\"hrt\"><div class=\"grid\"></div><h1>Create Magical Landing Pages</h1><p>A curated collection of animated, drop-in sections.</p><a>Get Started →</a><div class=\"panel\"><div class=\"beam\"></div></div></div>"}