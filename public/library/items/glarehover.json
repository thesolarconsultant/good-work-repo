{"id":"glarehover","code":"<style>.glr{position:relative;width:210px;height:120px;border-radius:16px;overflow:hidden;background:linear-gradient(135deg,#7A5CFF,var(--accent,#3366FF));\n display:grid;place-items:center;color:#fff;font:800 16px Inter,sans-serif;cursor:pointer}\n.glr::after{content:\"\";position:absolute;top:-60%;left:-30%;width:50%;height:220%;transform:rotate(25deg) translateX(-160%);\n background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);transition:transform .6s}\n.glr:hover::after{transform:rotate(25deg) translateX(320%)}</style>\n<div class=\"glr\">Glare Hover</div>"}