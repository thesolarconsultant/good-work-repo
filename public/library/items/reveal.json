{"id":"reveal","code":"<style>.rv{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.22,1,.36,1),transform .7s cubic-bezier(.22,1,.36,1);\n font:700 22px Inter,sans-serif;color:var(--ink,#fff);text-align:center;max-width:16ch}\n.rv.in{opacity:1;transform:none}</style>\n<div class=\"rv\" id=\"rv\">Content that rises in as it enters view</div>\n<script>\nvar el=document.getElementById('rv');\n// PRODUCTION: new IntersectionObserver(es=>es.forEach(e=>e.isIntersecting&&e.target.classList.add('in'))).observe(el);\nfunction loop(){el.classList.remove('in');requestAnimationFrame(function(){requestAnimationFrame(function(){el.classList.add('in');});});}\nloop();setInterval(loop,2600);\n</script>"}