{"id":"textreveal","code":"<style>.trv{font:700 22px Inter,sans-serif;color:var(--ink,#fff);max-width:20ch;text-align:center;line-height:1.4}\n.trv span{opacity:.14;filter:blur(4px);transition:opacity .5s,filter .5s;display:inline-block}\n.trv span.on{opacity:1;filter:blur(0)}</style>\n<div class=\"trv\" id=\"trv\"></div>\n<script>var t=\"Your home working as one clean system\".split(' '),el=document.getElementById('trv');\nel.innerHTML=t.map(function(w){return '<span>'+w+'&nbsp;</span>';}).join('');var sp=el.querySelectorAll('span');\nfunction play(){sp.forEach(function(s){s.classList.remove('on');});sp.forEach(function(s,i){setTimeout(function(){s.classList.add('on');},i*150);});}\nplay();setInterval(play,3800);</script>"}