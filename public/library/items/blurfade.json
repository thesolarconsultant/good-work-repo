{"id":"blurfade","code":"<style>.bf{display:flex;gap:10px}\n.bf i{width:56px;height:56px;border-radius:14px;background:linear-gradient(135deg,#7A5CFF,var(--accent,#3366FF));\n opacity:0;filter:blur(10px);animation:bfin .7s cubic-bezier(.22,1,.36,1) forwards}\n@keyframes bfin{to{opacity:1;filter:blur(0)}}</style>\n<div class=\"bf\" id=\"bf\"></div>\n<script>var el=document.getElementById('bf');function play(){el.innerHTML='';for(var i=0;i<3;i++){var d=document.createElement('i');d.style.animationDelay=(i*0.18)+'s';el.appendChild(d);}}play();setInterval(play,2800);</script>"}