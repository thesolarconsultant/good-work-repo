{"id":"flowingmenu","code":"<style>.flm{width:230px;border-radius:12px;overflow:hidden;border:1px solid var(--line,#262C34)}\n.flm a{position:relative;display:block;padding:12px 16px;color:var(--ink,#fff);text-decoration:none;font:800 16px Inter,sans-serif;overflow:hidden;border-bottom:1px solid var(--line,#262C34)}\n.flm a:last-child{border-bottom:0}\n.flm a .fill{position:absolute;inset:0;background:var(--accent,#3366FF);color:#0B0E13;display:flex;align-items:center;padding-left:16px;transform:translateY(101%);transition:.35s cubic-bezier(.22,1,.36,1)}\n.flm a:hover .fill{transform:none}</style>\n<div class=\"flm\"><a>Solar<span class=\"fill\">Solar →</span></a><a>Battery<span class=\"fill\">Battery →</span></a><a>Heating<span class=\"fill\">Heating →</span></a></div>"}