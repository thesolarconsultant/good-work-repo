{"id":"textanimate","code":"<style>.tan{font:800 30px Inter,sans-serif;color:var(--ink,#fff)}\n.tan span{display:inline-block;opacity:0;transform:translateY(14px);animation:tanin .5s cubic-bezier(.22,1,.36,1) forwards}\n@keyframes tanin{to{opacity:1;transform:none}}</style>\n<div class=\"tan\" id=\"tan\"></div>\n<script>var t=\"Animate me\",el=document.getElementById('tan');\nfunction play(){el.innerHTML=t.split('').map(function(c,i){return '<span style=\"animation-delay:'+(i*0.05)+'s\">'+(c===' '?'&nbsp;':c)+'</span>';}).join('');}\nplay();setInterval(play,2800);</script>"}