{"id":"avatars","code":"<style>.av{display:flex;align-items:center}\n.av span{width:38px;height:38px;border-radius:50%;border:2px solid #0B0E13;margin-left:-10px;display:grid;place-items:center;\n font:700 13px Inter,sans-serif;color:#fff;background:linear-gradient(135deg,#7A5CFF,var(--accent,#3366FF));animation:avin .4s cubic-bezier(.22,1,.36,1) both}\n.av span:first-child{margin-left:0}.av .more{background:var(--card,#171B22);border:2px solid var(--line,#262C34);color:var(--ink,#fff)}\n@keyframes avin{from{opacity:0;transform:scale(.5)}to{opacity:1;transform:none}}</style>\n<div class=\"av\" id=\"av\"></div>\n<script>var av=document.getElementById('av');\nfunction play(){av.innerHTML='';['SR','JM','KT','AB'].forEach(function(t,i){var s=document.createElement('span');s.textContent=t;s.style.animationDelay=(i*0.1)+'s';av.appendChild(s);});var m=document.createElement('span');m.className='more';m.textContent='+9';m.style.animationDelay='.4s';av.appendChild(m);}\nplay();setInterval(play,3200);</script>"}