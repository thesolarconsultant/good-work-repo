{"id":"boxreveal","code":"<style>.bxr{position:relative;display:inline-block;overflow:hidden;padding:4px 3px}\n.bxr .txt{font:900 30px Inter,sans-serif;color:var(--ink,#fff);opacity:0;animation:bxt 0s .5s forwards}\n.bxr .cover{position:absolute;inset:0;background:var(--accent,#3366FF);animation:bxc 1s ease forwards}\n@keyframes bxc{0%{transform:scaleX(0);transform-origin:left}50%{transform:scaleX(1);transform-origin:left}51%{transform:scaleX(1);transform-origin:right}100%{transform:scaleX(0);transform-origin:right}}\n@keyframes bxt{to{opacity:1}}</style>\n<div class=\"bxr\" id=\"bxr\"><span class=\"txt\">Reveal</span><span class=\"cover\"></span></div>\n<script>var wrap=document.getElementById('bxr');setInterval(function(){var n=wrap.cloneNode(true);wrap.parentNode.replaceChild(n,wrap);wrap=n;},3000);</script>"}