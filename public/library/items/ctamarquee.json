{"id":"ctamarquee","code":"<style>.ctm{position:relative;width:290px;height:196px;border-radius:16px;overflow:hidden;border:1px solid var(--line,#262C34);background:#0b0e13;display:flex;flex-direction:column;justify-content:center;gap:8px}\n.ctm .rowm{overflow:hidden}.ctm .rowm ul{display:flex;gap:8px;width:max-content;list-style:none;margin:0;padding:0}\n.ctm .r1 ul{animation:ctmm 16s linear infinite}.ctm .r2 ul{animation:ctmm 22s linear infinite reverse}.ctm .r3 ul{animation:ctmm 18s linear infinite}\n.ctm .tile{position:relative;width:44px;height:44px;border-radius:12px;background:var(--card,#171B22);border:1px solid rgba(255,255,255,.08);flex:none;overflow:hidden;display:grid;place-items:center;opacity:.7}\n.ctm .tile::before{content:\"\";position:absolute;width:60%;height:60%;border-radius:50%;filter:blur(11px);opacity:.75;background:linear-gradient(90deg,var(--accent,#3366FF),#FF2E88,#7C4DFF)}\n.ctm .tile svg{position:relative;width:20px;height:20px}\n@keyframes ctmm{to{transform:translateX(-50%)}}\n.ctm .center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;background:radial-gradient(62% 62% at 50% 50%,rgba(11,14,19,.9),transparent)}\n.ctm .ico{width:42px;height:42px;border-radius:14px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.15);display:grid;place-items:center;margin-bottom:9px}.ctm .ico svg{width:22px;height:22px}\n.ctm h3{color:#fff;font:800 16px Inter,sans-serif;margin:0 0 3px}.ctm p{color:var(--body,#B6BDC8);font:500 11px Inter,sans-serif;margin:0 0 10px}\n.ctm .go{background:var(--accent,#3366FF);color:#fff;font:700 11px Inter,sans-serif;padding:8px 16px;border-radius:999px;text-decoration:none}</style>\n<div class=\"ctm\"><div class=\"rowm r1\"><ul></ul></div><div class=\"rowm r2\"><ul></ul></div><div class=\"rowm r3\"><ul></ul></div>\n<div class=\"center\"><div class=\"ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21C7 17 3 13 3 8.5A4.5 4.5 0 0 1 12 6a4.5 4.5 0 0 1 9 2.5C21 13 17 17 12 21z\"/></svg></div>\n<h3>Stop wasting time on design.</h3><p>Start your 7-day free trial. No card required.</p><a class=\"go\">Get started →</a></div></div>\n<script>var IC=['<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"><path d=\"M12 21C7 17 3 13 3 8.5A4.5 4.5 0 0 1 12 6a4.5 4.5 0 0 1 9 2.5C21 13 17 17 12 21z\"/></svg>','<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18\"/></svg>','<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"><path d=\"M14 3v5h5M8 3h6l5 5v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z\"/></svg>','<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"><path d=\"M12 3l7 3v6c0 5-3.5 8-7 9-3.5-1-7-4-7-9V6z\"/></svg>','<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg>'];\ndocument.querySelectorAll('.ctm .rowm ul').forEach(function(u){var s='';for(var i=0;i<14;i++)s+='<li class=\"tile\">'+IC[i%IC.length]+'</li>';u.innerHTML=s;});</script>"}