{"id":"wordrise","code":"<style>.wr{font:800 32px Inter,sans-serif;color:var(--ink,#fff);text-align:center}\n.wr span{display:inline-block;opacity:0;transform:translateY(.6em);animation:wrise .6s cubic-bezier(.22,1,.36,1) forwards}\n@keyframes wrise{to{opacity:1;transform:none}}</style>\n<div class=\"wr\" id=\"wr\"></div>\n<script>\nvar words=\"Your home, working together\".split(' ');\nvar el=document.getElementById('wr');\nfunction play(){el.innerHTML=words.map(function(w,i){return '<span style=\"animation-delay:'+(i*0.12)+'s\">'+w+'&nbsp;</span>';}).join('');}\nplay();setInterval(play,3200);\n</script>"}