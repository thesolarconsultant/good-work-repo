{"id":"ring","code":"<style>.rg svg{transform:rotate(-90deg)}.rg .bg{fill:none;stroke:var(--line,#262C34);stroke-width:9}\n.rg .fg{fill:none;stroke:var(--accent,#3366FF);stroke-width:9;stroke-linecap:round;stroke-dasharray:314;stroke-dashoffset:314;\n transition:stroke-dashoffset 1.5s cubic-bezier(.22,1,.36,1);filter:drop-shadow(0 0 5px rgba(51,102,255,.55))}\n.rg .fg.on{stroke-dashoffset:78}</style>\n<div class=\"rg\"><svg width=\"110\" height=\"110\" viewBox=\"0 0 110 110\"><circle class=\"bg\" cx=\"55\" cy=\"55\" r=\"50\"/><circle class=\"fg\" id=\"fg\" cx=\"55\" cy=\"55\" r=\"50\"/></svg></div>\n<script>var f=document.getElementById('fg');function p(){f.classList.remove('on');requestAnimationFrame(function(){requestAnimationFrame(function(){f.classList.add('on');});});}p();setInterval(p,3000);</script>"}