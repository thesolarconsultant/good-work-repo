{"id":"presslogos","code":"<style>.prs{width:340px;font-family:Inter,system-ui,sans-serif;padding:16px 6px;text-align:center}\n.prs h3{margin:0 0 14px;color:var(--body,#B6BDC8);font:700 10px Inter,sans-serif;letter-spacing:.14em}\n.prs .grid{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px 10px;place-items:center}\n.prs span{color:#8A93A2;font:700 12px Georgia,serif;opacity:.85;transition:.2s;white-space:nowrap}\n.prs span:hover{color:var(--ink,#fff);opacity:1}\n.prs .sans{font-family:Inter,sans-serif;font-weight:800;letter-spacing:-.02em}</style>\n<div class=\"prs\"><h3>FEATURED IN</h3><div class=\"grid\"><span>The Times</span><span class=\"sans\">Forbes</span><span>Bloomberg</span><span class=\"sans\">WIRED</span><span class=\"sans\">TechCrunch</span><span>The Post</span><span class=\"sans\">Insider</span><span>Guardian</span></div></div>"}