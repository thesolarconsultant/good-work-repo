{"id":"hypertext","code":"<style>.hyp{font:800 30px 'JetBrains Mono',ui-monospace,monospace;color:var(--ink,#fff);letter-spacing:.06em}</style>\n<div class=\"hyp\" id=\"hyp\"></div>\n<script>var target=\"HYPER TEXT\",CH=\"ABCDEFGHIJKLMNOPQRSTUVWXYZ\",el=document.getElementById('hyp');\nfunction run(){var frame=0;var iv=setInterval(function(){el.textContent=target.split('').map(function(c,i){if(c===' ')return ' ';return (i*3<frame)?c:CH[Math.floor(Math.random()*26)];}).join('');frame++;if(frame>target.length*3+3)clearInterval(iv);},45);}\nrun();setInterval(run,3000);</script>"}