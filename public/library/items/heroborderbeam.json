{"id":"heroborderbeam","code":"<style>.hbb{width:340px;font-family:Inter,system-ui,sans-serif;padding:18px 10px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:12px}\n.hbb h1{margin:0;font:800 26px Inter,sans-serif;line-height:1.1;background:linear-gradient(160deg,#fff 30%,#8A93A2);-webkit-background-clip:text;background-clip:text;color:transparent}\n.hbb p{margin:0;color:var(--body,#B6BDC8);font:500 12px Inter,sans-serif;max-width:260px;line-height:1.5}\n.hbb a{background:var(--accent,#3366FF);color:#fff;font:700 12px Inter,sans-serif;padding:10px 20px;border-radius:99px;text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:.2s}\n.hbb a:hover{box-shadow:0 0 0 2px var(--accent-2,#7A5CFF),0 0 0 4px rgba(122,92,255,.3)}\n.hbb .wrap{position:relative;width:300px;margin-top:6px}\n.hbb .glow{position:absolute;left:20%;right:20%;top:-10px;height:60px;background:var(--accent,#3366FF);filter:blur(50px);opacity:.5}\n.hbb .panel{position:relative;height:120px;border-radius:12px;border:1px solid var(--line,#262C34);background:linear-gradient(#171B22,#0E1219);overflow:hidden}\n.hbb .panel::after{content:\"\";position:absolute;top:12px;left:12px;right:12px;bottom:12px;border-radius:8px;background:repeating-linear-gradient(#2A2F38 0 6px,transparent 6px 18px)}\n.hbb .beam{position:absolute;inset:0;border-radius:12px;padding:1.5px;background:conic-gradient(from var(--ha,0deg),transparent 0 70%,var(--accent-2,#7A5CFF) 82%,var(--accent,#3366FF) 92%,transparent 100%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:hbbspin 5s linear infinite}\n@property --ha{syntax:'<angle>';inherits:false;initial-value:0deg}\n@keyframes hbbspin{to{--ha:360deg}}\n@media(prefers-reduced-motion:reduce){.hbb .beam{animation:none}}</style>\n<div class=\"hbb\"><h1>Create Magical Landing Pages</h1><p>A curated collection of animated, drop-in sections for fast marketing sites.</p><a>Get Started →</a><div class=\"wrap\"><div class=\"glow\"></div><div class=\"panel\"><div class=\"beam\"></div></div></div></div>"}