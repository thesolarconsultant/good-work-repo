{"id":"pricingtiers","code":"<style>.prt{display:flex;gap:10px;font-family:Inter,system-ui,sans-serif;align-items:stretch;padding:14px 4px}\n.prt .card{width:140px;border:1px solid var(--line,#262C34);border-radius:16px;padding:16px 14px;background:var(--card,#171B22);display:flex;flex-direction:column;gap:9px}\n.prt .card.pop{border-color:var(--accent,#3366FF);box-shadow:0 0 0 1px var(--accent,#3366FF),0 14px 34px rgba(51,102,255,.20);transform:translateY(-8px)}\n.prt .tag{align-self:flex-start;background:var(--accent,#3366FF);color:#fff;font:700 8px Inter,sans-serif;padding:3px 8px;border-radius:999px;text-transform:uppercase;letter-spacing:.07em}\n.prt h4{margin:0;color:var(--body,#B6BDC8);font:700 11px Inter,sans-serif;text-transform:uppercase;letter-spacing:.05em}\n.prt .price{color:var(--ink,#fff);font:800 26px Inter,sans-serif;line-height:1}.prt .price span{font:600 10px Inter,sans-serif;color:var(--body,#B6BDC8)}\n.prt ul{list-style:none;margin:2px 0 0;padding:0;display:flex;flex-direction:column;gap:6px;flex:1}\n.prt li{color:var(--body,#B6BDC8);font:500 10px Inter,sans-serif;display:flex;gap:6px;align-items:center}\n.prt li::before{content:\"\\2713\";color:var(--accent,#3366FF);font-weight:800;font-size:11px}\n.prt a{display:block;text-align:center;text-decoration:none;font:700 11px Inter,sans-serif;padding:9px;border-radius:10px}\n.prt .ghost{color:var(--ink,#fff);border:1px solid var(--line,#262C34)}\n.prt .solid{color:#fff;background:var(--accent,#3366FF)}</style>\n<div class=\"prt\">\n<div class=\"card\"><h4>Starter</h4><div class=\"price\">$0<span>/mo</span></div><ul><li>1 project</li><li>Community support</li><li>Basic analytics</li></ul><a class=\"ghost\">Choose</a></div>\n<div class=\"card pop\"><span class=\"tag\">Popular</span><h4>Pro</h4><div class=\"price\">$29<span>/mo</span></div><ul><li>Unlimited projects</li><li>Priority support</li><li>Advanced analytics</li><li>Custom domains</li></ul><a class=\"solid\">Choose</a></div>\n<div class=\"card\"><h4>Team</h4><div class=\"price\">$99<span>/mo</span></div><ul><li>Everything in Pro</li><li>SSO &amp; roles</li><li>Audit logs</li></ul><a class=\"ghost\">Choose</a></div>\n</div></div>"}